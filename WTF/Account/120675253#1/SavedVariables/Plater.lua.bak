},
["Name"] = "Extra Quest Icon",
["Options"] = {
},
["OptionsValues"] = {
},
["PlaterCore"] = 1,
["Prio"] = 99,
["Revision"] = 38,
["Time"] = 1705867335,
["semver"] = "1.0.1",
["url"] = "https://wago.io/platerquesticon/2",
["version"] = 2,
},
[31] = {
["Author"] = "Viash-Thrall",
["Desc"] = "Sets the cast bar color to the specified one if your interrupt spell is not ready. Uses other Plater color settings otherwise.",
["Enabled"] = true,
["Hooks"] = {
["Cast Start"] = "function (self, unitId, unitFrame, envTable, modTable)\
    if not envTable.lastUpdateTime or (envTable.lastUpdateTime < modTable.lastUpdateTime) then\
        modTable.setCastColorFunction (unitFrame)\
        envTable.lastUpdateTime = modTable.lastUpdateTime\
    end\
end",
["Cast Update"] = "function (self, unitId, unitFrame, envTable, modTable)\
    unitFrame.castBar:UpdateCastColor()\
end",
["Constructor"] = "function (self, unitId, unitFrame, envTable, modTable)\
    modTable.updateInterruptId(unitFrame)\
    modTable.setCastColorFunction(unitFrame)\
end",
["Initialization"] = "function (modTable)\
    \
    -- settings:\
    local noKickReadyColor = modTable.config.noKickReadyColor or \"blue\"\
    local kickReadyInTimeColor = modTable.config.kickReadyInTimeColor or \"purple\"\
    local kickOutOfRangeColor = modTable.config.kickOutOfRangeColor or \"orange\"\
    local kickOutOfRangeEnabled = modTable.config.kickOutOfRangeEnabled\
    local kickReadyInTimeGraceTime = modTable.config.kickReadyInTimeGraceTime or 0.5 --sec - additional time on the CD to account for reaction, lag, etc\
    local checkCovenant = true\
    local enableSigil = false\
    local showSpark = modTable.config.showSpark\
    local sparkColor = modTable.config.sparkColor\
    local sparkWidth = modTable.config.sparkWidth\
    local sparkTexture = modTable.config.sparkTexture\
    local textureChangeNotReady = modTable.config.textureChangeNotReady\
    local defaultTexture\
    local notReadyTexture\
    local LSM = LibStub:GetLibrary (\"LibSharedMedia-3.0\")\
    if not LSM then\
        textureChangeNotReady = false\
    else\
        defaultTexture = LSM:Fetch (\"statusbar\", Plater.db.profile.cast_statusbar_texture)\
        notReadyTexture = LSM:Fetch (\"statusbar\", modTable.config.notReadyTexture) or modTable.config.notReadyTexture ~= \"\" and modTable.config.notReadyTexture or defaultTexture\
    end\
    \
    local specialCastColorsEnabled = modTable.config.specialColorsEnabled\
    local specialColorsData = modTable.config.specialColors\
    local platerCastColorsEnabled = modTable.config.platerCastColorsEnabled\
    local specialColorsForNonInterruptibleEnabled = modTable.config.specialColorsForNonInterruptibleEnabled\
    local specialColors = {}\
    local additionalInterruptColors = {\
        [31935] = {Plater:ParseColors(\"greenyellow\")}, --prot avenger's shield\
        --[375576] = {Plater:ParseColors(\"greenyellow\")}, --paladin kyrian bell\
    }\
    \
    if platerCastColorsEnabled or specialColorsForNonInterruptibleEnabled then\
        for id, colorData in pairs(Plater.db.profile.cast_colors) do\
            if colorData and colorData[1] and colorData[2] then\
                specialColors[tonumber(id) or id] = {Plater:ParseColors(colorData[2])}\
            end\
        end\
    end\
    if specialCastColorsEnabled or specialColorsForNonInterruptibleEnabled then\
        for id, color in pairs(specialColorsData) do\
            specialColors[tonumber(id) or id] = {Plater:ParseColors(color)}\
        end\
    end\
    local useSpecial = specialCastColorsEnabled or platerCastColorsEnabled\
    \
    \
    -- functions:\
    \
    -- determine interrupt spell according to spec\
    function modTable.updateInterruptIDs ()\
        local specId = \"N/A\"\
        if WOW_PROJECT_ID == WOW_PROJECT_MAINLINE then\
            specId = GetSpecializationInfo(GetSpecialization())\
        end\
        modTable.knownSpecID = specId\
        local interruptIDs = {} -- contains: [spellID] = <is player ability>, false meaning pet or weird workarounds needed\
        if WOW_PROJECT_ID == WOW_PROJECT_MAINLINE then\
            if Plater.PlayerClass == \"ROGUE\" then\
                interruptIDs[1766] = true\
            elseif Plater.PlayerClass == \"DEATHKNIGHT\" then\
                interruptIDs[47528] = true\
            elseif Plater.PlayerClass == \"DEMONHUNTER\" then\
                interruptIDs[183752] = true\
                if specId == 581 then\
                    interruptIDs[202137] = enableSigil\
                end\
            elseif Plater.PlayerClass == \"DRUID\" then\
                if specId == 103 or specId == 104 or specId == 105 then\
                    interruptIDs[106839] = true -- feral/guardian/resto\
                elseif specId == 102 then\
                    interruptIDs[78675] = true -- moonkin\
                end\
            elseif Plater.PlayerClass == \"HUNTER\" then\
                if specId == 255 then\
                    interruptIDs[187707] = true -- SV\
                else\
                    interruptIDs[147362] = true -- BM/MS\
                end\
            elseif Plater.PlayerClass == \"MONK\" then\
                interruptIDs[116705] = true --WW/BM/MW\
            elseif Plater.PlayerClass == \"PALADIN\" then\
                interruptIDs[96231] = true --prot/ret/holy\
                if specId == 66 then\
                    interruptIDs[31935] = true --prot avenger's shield\
                    if IsPlayerSpell(375576) then\
                        interruptIDs[375576] = true --Divine Toll\
                    end\
                end\
            elseif Plater.PlayerClass == \"SHAMAN\" then\
                interruptIDs[57994] = true\
            elseif Plater.PlayerClass == \"WARRIOR\" then\
                interruptIDs[6552] = true\
                if modTable.isTalentLearned(90307) then --Disrupting Shout\
                    interruptIDs[90307] = \"386071\"\
                end\
            elseif Plater.PlayerClass == \"MAGE\" then\
                interruptIDs[2139] = true\
            elseif Plater.PlayerClass == \"PRIEST\" then\
                if specId == 258 then\
                    interruptIDs[15487] = true\
                end\
            elseif Plater.PlayerClass == \"WARLOCK\" then\
                interruptIDs[119910] = 119898 --Spell Lock (command ability)\
                if IsPlayerSpell(108503) then --GoSac\
                    interruptIDs[132409] = 119898 --sacrificed Spell Lock (command ability)\
                end\
                if IsPlayerSpell(212619) then --Call Felhunter (PVP ability)\
                    interruptIDs[212619] = true\
                end\
                if specId == 266 then\
                    interruptIDs[119914] = 119898 --demo/fel guard  Axe Toss (command ability)\
                end\
            elseif Plater.PlayerClass == \"EVOKER\" then\
                interruptIDs[351338] = true --quell talent\
            end\
        else -- classic\
            if Plater.PlayerClass == \"ROGUE\" then\
                interruptIDs[1766] = true\
            elseif Plater.PlayerClass == \"DEATHKNIGHT\" then\
                interruptIDs[47528] = true\
                interruptIDs[47476] = true\
            elseif Plater.PlayerClass == \"DRUID\" then\
                interruptIDs[16979] = true\
                interruptIDs[80964] = true\
                interruptIDs[80965] = true\
            elseif Plater.PlayerClass == \"HUNTER\" then\
                interruptIDs[34490] = true\
            elseif Plater.PlayerClass == \"SHAMAN\" then\
                interruptIDs[57994] = true\
            elseif Plater.PlayerClass == \"WARRIOR\" then\
                interruptIDs[6552] = true\
                interruptIDs[72] = true\
            elseif Plater.PlayerClass == \"MAGE\" then\
                interruptIDs[2139] = true\
            elseif Plater.PlayerClass == \"PRIEST\" then\
                interruptIDs[15487] = true\
            elseif Plater.PlayerClass == \"WARLOCK\" then\
                interruptIDs[19647] = true --Spell Lock\
            end\
        end\
        modTable.interruptSpellIDs = interruptIDs\
    end\
    \
    function modTable.updateInterruptId (unitFrame)\
        local specId = \"N/A\"\
        if WOW_PROJECT_ID == WOW_PROJECT_MAINLINE then\
            specId = GetSpecializationInfo(GetSpecialization())\
        end\
        if not modTable.interruptSpellIDs or modTable.knownSpecID ~= specId then\
            modTable.updateInterruptIDs()\
        end\
        unitFrame.castBar.interruptSpellIDs = modTable.interruptSpellIDs\
    end\
    \
    function modTable.isTalentLearned(nodeID)\
        if WOW_PROJECT_ID ~= WOW_PROJECT_MAINLINE then return false end\
        local talentConfig = C_ClassTalents.GetActiveConfigID()\
        local nodeInfo = talentConfig and nodeID and C_Traits.GetNodeInfo(talentConfig, nodeID)\
        return nodeInfo and nodeInfo.entryIDsWithCommittedRanks and nodeInfo.entryIDsWithCommittedRanks[1] and true or false\
    end\
    \
    local function isSpellOrTalentKnown(spellId)\
        if IsSpellKnown(spellId) or IsSpellKnown(spellId, true) then -- check pet as well\
            return true\
        elseif modTable.isTalentLearned(spellId) then\
            return true\
        end\
    end\
    \
    local function setCastBarTexture(castBar, notReady)\
        if textureChangeNotReady then\
            local texture = notReady and notReadyTexture or defaultTexture\
            if castBar.curTextureNotInterrupt ~= texture then\
                castBar:SetStatusBarTexture (texture)\
                castBar.curTextureNotInterrupt = texture\
            end\
        end\
    end\
    \
    local GetSpellCooldown = GetSpellCooldown or function(spellID)\
        local spellCooldownInfo = C_Spell.GetSpellCooldown(spellID)\
        if spellCooldownInfo then\
            return spellCooldownInfo.startTime, spellCooldownInfo.duration, spellCooldownInfo.isEnabled, spellCooldownInfo.modRate\
        end\
    end\
    local IsSpellInRange = IsSpellInRange and function(id) return IsSpellInRange(GetSpellInfo(id)) end or function(id, unit)\
        local result = C_Spell.IsSpellInRange(id, unit)\
        if result == true then\
            return 1\
        elseif result == false then\
            return 0\
        end\
        return nil\
    end\
    function modTable.setCastColorFunction (unitFrame)\
        -- create spark (if needed)\
        local castBar = unitFrame.castBar\
        if not castBar.InterruptSpark then\
            castBar.InterruptSpark = castBar:CreateTexture (nil, \"overlay\")\
            castBar.InterruptSpark:SetDrawLayer (\"overlay\", 4)\
            castBar.InterruptSpark:SetBlendMode (\"ADD\")\
            castBar.InterruptSpark:SetHeight(castBar:GetHeight() + 6)\
        end\
        castBar.InterruptSpark:SetTexture(Plater.SparkTextures[sparkTexture])\
        castBar.InterruptSpark:SetVertexColor(Plater:ParseColors(sparkColor))\
        castBar.InterruptSpark:SetWidth(sparkWidth)\
        \
        if not LSM then\
            textureChangeNotReady = false\
        else\
            defaultTexture = LSM:Fetch (\"statusbar\", Plater.db.profile.cast_statusbar_texture)\
            notReadyTexture = LSM:Fetch (\"statusbar\", modTable.config.notReadyTexture) or modTable.config.notReadyTexture ~= \"\" and modTable.config.notReadyTexture or defaultTexture\
        end\
        \
        -- overwrite the color function:\
        castBar.GetCastColor = function (self)\
            \
            self.InterruptSpark:Hide()\
            setCastBarTexture(self)\
            \
            local interruptCD, interruptReadyInTime = nil, false\
            local interruptDur, interruptStart = 0, 0\
            local usedInterruptSpellId\
            local spellOutOfRange = false --skip per default\
            if self.interruptSpellIDs and self.unit and UnitCanAttack(\"player\", self.unit) then\
                \
                for interruptSpellId, playerAbility in pairs(self.interruptSpellIDs) do\
                    if playerAbility == true or type(playerAbility) == \"string\"  then\
                        if isSpellOrTalentKnown(interruptSpellId) then\
                            interruptSpellId = tonumber(playerAbility) or interruptSpellId\
                            local cdStart, cdDur =  GetSpellCooldown(interruptSpellId)\
                            local tmpInterruptCD = (cdStart > 0 and  cdDur - (GetTime() - cdStart)) or 0\
                            --print(interruptSpellId, cdStart, cdDur, tmpInterruptCD)\
                            if not interruptCD or (tmpInterruptCD < interruptCD) then\
                                interruptCD = tmpInterruptCD\
                                interruptDur = cdDur\
                                interruptStart = cdStart\
                                spellOutOfRange = kickOutOfRangeEnabled and IsSpellInRange(interruptSpellId, self.unit) == 0\
                            elseif tmpInterruptCD == 0 then\
                                if additionalInterruptColors[interruptSpellId] or not usedInterruptSpellId then\
                                    usedInterruptSpellId = interruptSpellId\
                                elseif not additionalInterruptColors[interruptSpellId] and additionalInterruptColors[usedInterruptSpellId] then\
                                    usedInterruptSpellId = interruptSpellId\
                                end\
                            end\
                        end\
                    else\
                        if type(playerAbility) == \"number\" then\
                            -- workaround for spell overrides (on WL command ability, etc.)\
                            if FindSpellOverrideByID(playerAbility) == interruptSpellId then\
                                local cdStart, cdDur =  GetSpellCooldown(interruptSpellId)\
                                local tmpInterruptCD = (cdStart > 0 and  cdDur - (GetTime() - cdStart)) or 0\
                                if not interruptCD or  (tmpInterruptCD < interruptCD) then\
                                    interruptCD = tmpInterruptCD\
                                    interruptDur = cdDur\
                                    interruptStart = cdStart\
                                    spellOutOfRange = kickOutOfRangeEnabled and IsSpellInRange(interruptSpellId, self.unit) == 0\
                                elseif tmpInterruptCD == 0 then\
                                    if additionalInterruptColors[interruptSpellId] or not usedInterruptSpellId then\
                                        usedInterruptSpellId = interruptSpellId\
                                    elseif not additionalInterruptColors[interruptSpellId] and additionalInterruptColors[usedInterruptSpellId] then\
                                        usedInterruptSpellId = interruptSpellId\
                                    end\
                                end \
                            end\
                        end\
                    end\
                end\
                \
                if not interruptCD then\
                    interruptCD = 0\
                end\
                \
                if self.channeling then\
                    interruptReadyInTime = (interruptCD + kickReadyInTimeGraceTime) < self.value\
                else\
                    interruptReadyInTime = (interruptCD + kickReadyInTimeGraceTime) < (self.maxValue - self.value)\
                end\
            end\
            \
            if not interruptCD then\
                interruptCD = 0\
            end\
            \
            if (not self.canInterrupt) then\
                return (specialColorsForNonInterruptibleEnabled and (specialColors[self.spellName] or specialColors[self.spellID])) or self.Colors.NonInterruptible\
                \
            elseif (self.failed) then\
                return self.Colors.Failed\
                \
            elseif (self.interrupted) then\
                return self.Colors.Interrupted\
                \
            elseif (self.finished) then\
                return self.Colors.Finished\
                \
            elseif interruptCD > 0 and interruptReadyInTime then\
                if showSpark then\
                    self.InterruptSpark:Show()\
                    local sparkPosition = (interruptStart + interruptDur - self.spellStartTime + kickReadyInTimeGraceTime)/self.maxValue\
                    if self.channeling then\
                        sparkPosition = 1-sparkPosition\
                    end\
                    self.InterruptSpark:SetPoint (\"center\", self, \"left\", sparkPosition  * self:GetWidth(), 0)\
                end\
                setCastBarTexture(self, true)\
                return additionalInterruptColors[usedInterruptSpellId] or kickReadyInTimeColor\
                \
            elseif interruptCD > 0 then\
                setCastBarTexture(self, true)\
                return noKickReadyColor\
                \
            elseif kickOutOfRangeEnabled and spellOutOfRange then\
                return kickOutOfRangeColor\
                \
            elseif (self.channeling) then\
                return (useSpecial and (specialColors[self.spellName] or specialColors[self.spellID])) or self.Colors.Channeling\
                \
            else\
                return (useSpecial and (specialColors[self.spellName] or specialColors[self.spellID])) or self.Colors.Casting\
                \
            end\
        end\
    end\
    \
    modTable.lastUpdateTime = time()\
    \
end",
["Nameplate Added"] = "function (self, unitId, unitFrame, envTable, modTable)\
    modTable.updateInterruptId(unitFrame)\
end\
\
\
",
["Player Talent Update"] = "function (self, unitId, unitFrame, envTable, modTable)\
    modTable.updateInterruptIDs()\
    modTable.updateInterruptId(unitFrame)\
end\
\
\
",
},
