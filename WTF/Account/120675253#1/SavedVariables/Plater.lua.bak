},
["PlaterCore"] = 1,
["Prio"] = 1,
["Revision"] = 320,
["Time"] = 1755240413,
},
[2] = {
["Author"] = "Luckyone-Laughing Skull",
["Desc"] = "",
["Enabled"] = true,
["Hooks"] = {
["Cast Start"] = "function(self, unitId, unitFrame, envTable)\
    envTable.UpdateIconPosition(unitFrame)\
    envTable.UpdateBorder(unitFrame, true)\
end",
["Cast Update"] = "function(self, unitId, unitFrame, envTable)\
    envTable.UpdateIconPosition(unitFrame)\
end",
["Constructor"] = "function(self, unitId, unitFrame, envTable)\
    \
    -- Last update by Luckyone: August 10, 2025\
    \
    -- This is the Plater setting \"Cast Bar -> Show Icon\"\
    envTable.ShowIcon = Plater.db.profile.castbar_icon_show\
    \
    local castBar = unitFrame.castBar\
    local healthBar = unitFrame.healthBar\
    local icon = castBar.Icon\
    local shield = castBar.BorderShield\
    \
    function envTable.UpdateIconPosition(unitFrame)\
        -- Remove the shield for uninterruptible casts\
        -- We color the uninterruptible castbar red\
        shield:Hide()\
        \
        if envTable.ShowIcon then -- The option is enabled, icon should be displayed\
            if not icon then return end\
            icon:ClearAllPoints()\
            PixelUtil.SetPoint(icon, 'TOPLEFT', healthBar, 'BOTTOMLEFT', 0, 0)\
            icon:SetHeight(8)\
            icon:SetWidth(8)\
            icon:Show()\
        else -- The option is disabled, icon should be hidden\
            icon:Hide()\
        end\
    end\
    \
    function envTable.UpdateBorder(unitFrame, casting)\
        if casting then\
            -- This is our border while castbar is shown\
            healthBar.border:ClearAllPoints()\
            PixelUtil.SetPoint(healthBar.border, 'TOPLEFT', healthBar, 'TOPLEFT', 0, 0)\
            PixelUtil.SetPoint(healthBar.border, 'BOTTOMRIGHT', castBar, 'BOTTOMRIGHT', 0, 0)\
        else\
            -- This is our border while castbar is hidden\
            healthBar.border:ClearAllPoints()\
            PixelUtil.SetPoint(healthBar.border, 'TOPLEFT', healthBar, 'TOPLEFT', 0, 0)\
            PixelUtil.SetPoint(healthBar.border, 'BOTTOMRIGHT', healthBar, 'BOTTOMRIGHT', 0, 0)\
        end\
    end\
    -- Make sure we don't hook over and over\
    if not unitFrame.castBar.borderChangeHooked then\
        hooksecurefunc(unitFrame.castBar, 'Hide', function() envTable.UpdateBorder(unitFrame, false) end)\
        unitFrame.castBar.borderChangeHooked = true\
    end\
end",
["Nameplate Removed"] = "function(self, unitId, unitFrame, envTable)\
    envTable.UpdateBorder(unitFrame, false)\
end",
},
