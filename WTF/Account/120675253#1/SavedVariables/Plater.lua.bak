[14] = {
["Author"] = "Ditador-Azralon",
["Desc"] = "Reorder buffs and debuffs following the settings set in the constructor.",
["Enabled"] = false,
["Hooks"] = {
["Initialization"] = "function (modTable)\
    \
    local sortByTime = true\
    local invertSort = true\
    local npcSeparatedFromPlayer = true\
    \
    --which auras goes first, assign a value (any number), bigger value goes first\
    local priority = {\
        [\"Vampiric Touch\"] = 50,\
        [\"Shadow Word: Pain\"] = 22,\
        [\"Mind Flay\"] = 5,\
        [\"Pistol Shot\"] = 50,\
        [\"Marked for Death\"] = 99,\
        [\"Garrote\"] = 95,\
        [\"Rupture\"] = 90,\
        [\"Sigil of Flame\"] = 50,\
    }\
    \
    -- Sort function - do not touch\
    Plater.db.profile.aura_sort = true\
    \
    \
    function Plater.AuraIconsSortFunction (aura1, aura2)\
        local p1 = priority[aura1.SpellId] or priority[aura1.SpellName] or aura1.layoutIndex or 1\
        local p2 = priority[aura2.SpellId] or priority[aura2.SpellName] or aura2.layoutIndex or 1\
        \
        if npcSeparatedFromPlayer then\
            if aura1.IsFromPlayer and not aura2.IsFromPlayer then\
                return false\
            elseif not aura1.IsFromPlayer and aura2.IsFromPlayer then\
                return true\
            end\
        end\
        \
        if sortByTime and p1 == p2 then\
            if invertSort then\
                return (aura1.Duration == 0 and 99999999 or aura1.RemainingTime or 0) > (aura2.Duration == 0 and 99999999 or aura2.RemainingTime or 0)\
            else\
                return (aura1.Duration == 0 and 99999999 or aura1.RemainingTime or 0) < (aura2.Duration == 0 and 99999999 or aura2.RemainingTime or 0)\
            end\
        else\
            if invertSort then\
                return p1 < p2\
            else\
                return p1 > p2\
            end\
        end\
    end\
    \
end\
\
\
\
\
\
