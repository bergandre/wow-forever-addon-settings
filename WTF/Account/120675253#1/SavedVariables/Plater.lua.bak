    if (not plateFrame.BWC_RedBackground) then\
        plateFrame.BWC_RedBackground = plateFrame:CreateTexture(nil, \"background\")\
        plateFrame.BWC_RedBackground:SetAllPoints()\
    end\
    \
    plateFrame.BWC_RedBackground:SetTexture([[Interface/AddOns/Plater/masks/mask1]])\
    plateFrame.BWC_RedBackground:Hide()\
    \
    function envTable.ShowBackground(unitFrame)\
        local plateFrame = unitFrame.PlateFrame\
        plateFrame.BWC_RedBackground:SetVertexColor(1, 0, 0, 0.4)\
        plateFrame.BWC_RedBackground:Show()\
    end\
    \
    function envTable.HideBackground(unitFrame)\
        plateFrame.BWC_RedBackground:Hide()\
    end\
end\
