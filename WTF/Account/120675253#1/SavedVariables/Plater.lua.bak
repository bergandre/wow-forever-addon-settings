["Time"] = 1672514185,
["UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    local castBar = unitFrame.castBar\
    local textures = unitFrame.felAnimation.Textures\
    \
    if (envTable._CastPercent > envTable.NextPercent) then\
        local nextPercent = 100 / scriptTable.config.segmentsAmount\
        \
        textures[envTable.CurrentTexture]:Show()\
        textures[envTable.CurrentTexture].animGroup:Play()\
        \
        envTable.NextPercent = envTable.NextPercent + nextPercent \
        envTable.CurrentTexture = envTable.CurrentTexture + 1\
        \
        --print(envTable.NextPercent, envTable.CurrentTexture)\
        \
        if (envTable.CurrentTexture == #textures) then\
            envTable.NextPercent = 98\
        elseif (envTable.CurrentTexture > #textures) then\
            envTable.NextPercent = 999\
        end\
    end\
    \
    local normalizedPercent = envTable._CastPercent / 100\
    local textureStretched = unitFrame.felAnimation.textureStretched\
    local point = DetailsFramework:GetBezierPoint(normalizedPercent, 0, 0.001, 1)\
    textureStretched:SetPoint(\"left\", castBar, \"left\", point * envTable.castBarWidth, 0)\
    \
    self.ThrottleUpdate = 0\
end",
["semver"] = "",
["url"] = "",
["version"] = -1,
},
[51] = {
["Author"] = "Terciob",
["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    --insert code here\
    \
    if (not unitFrame.TextureWatchStep) then\
        \
        unitFrame.TextureWatchStep = true\
        \
        local animationFrame = CreateFrame(\"frame\", nil, unitFrame)\
        \
        \
        --> single animation group\
        local bearTrapAnimation = animationFrame:CreateAnimationGroup(\"beartrapAnimationGroup\")\
        bearTrapAnimation:SetLooping(\"NONE\")\
        \
        --> widgets:\
        \
        ----------------------------------------------\
        \
        local leftTrap  = animationFrame:CreateTexture(\"$parentleftTrapTexture\", \"ARTWORK\")\
        leftTrap:SetTexture([[Interface\\AddOns\\Plater\\images\\icon_beartrap_2.png]])\
        leftTrap:SetDrawLayer(\"ARTWORK\", 0)\
        leftTrap:SetPoint(\"center\", animationFrame, \"center\", -48, 0)\
        leftTrap:SetSize(100, 100)\
        leftTrap:SetTexCoord(1, 0.0010000000149012, 0.0010000000149012, 1)\
        \
        --> animations for leftTrap\
        \
        leftTrap.rotation = bearTrapAnimation:CreateAnimation(\"ROTATION\")\
        leftTrap.rotation:SetTarget(leftTrap)\
        leftTrap.rotation:SetOrder(1)\
        leftTrap.rotation:SetDuration(0.195999994874)\
        leftTrap.rotation:SetStartDelay(0.39999997615814)\
        leftTrap.rotation:SetDegrees(-90)\
        leftTrap.rotation:SetOrigin(\"bottom\", 0, 0)\
        leftTrap.rotation = bearTrapAnimation:CreateAnimation(\"ROTATION\")\
        leftTrap.rotation:SetTarget(leftTrap)\
        leftTrap.rotation:SetOrder(6)\
        leftTrap.rotation:SetDuration(0.195999994874)\
        leftTrap.rotation:SetDegrees(90)\
        leftTrap.rotation:SetOrigin(\"bottom\", 0, 0)\
        leftTrap.alpha = bearTrapAnimation:CreateAnimation(\"ALPHA\")\
        leftTrap.alpha:SetTarget(leftTrap)\
        leftTrap.alpha:SetOrder(6)\
        leftTrap.alpha:SetDuration(0.195999994874)\
        leftTrap.alpha:SetFromAlpha(1)\
        leftTrap.alpha:SetToAlpha(0)\
        \
        ----------------------------------------------\
        \
        local rightTrap  = animationFrame:CreateTexture(\"$parentrightTrapTexture\", \"ARTWORK\")\
        rightTrap:SetTexture([[Interface\\AddOns\\Plater\\images\\icon_beartrap_2.png]])\
        rightTrap:SetDrawLayer(\"ARTWORK\", 0)\
        rightTrap:SetPoint(\"center\", animationFrame, \"center\", 0, 0)\
        rightTrap:SetSize(100, 100)\
        \
        --> animations for rightTrap\
        \
        rightTrap.rotation = bearTrapAnimation:CreateAnimation(\"ROTATION\")\
        rightTrap.rotation:SetTarget(rightTrap)\
        rightTrap.rotation:SetOrder(1)\
        rightTrap.rotation:SetDuration(0.195999994874)\
        rightTrap.rotation:SetStartDelay(0.39999997615814)\
        rightTrap.rotation:SetDegrees(90)\
        rightTrap.rotation:SetOrigin(\"bottom\", 0, 0)\
        rightTrap.rotation = bearTrapAnimation:CreateAnimation(\"ROTATION\")\
        rightTrap.rotation:SetTarget(rightTrap)\
        rightTrap.rotation:SetOrder(6)\
        rightTrap.rotation:SetDuration(0.195999994874)\
        rightTrap.rotation:SetDegrees(-90)\
        rightTrap.rotation:SetOrigin(\"bottom\", 0, 0)\
        rightTrap.alpha = bearTrapAnimation:CreateAnimation(\"ALPHA\")\
        rightTrap.alpha:SetTarget(rightTrap)\
        rightTrap.alpha:SetOrder(6)\
        rightTrap.alpha:SetDuration(0.195999994874)\
        rightTrap.alpha:SetFromAlpha(1)\
        rightTrap.alpha:SetToAlpha(0)\
        \
        ----------------------------------------------\
        \
        local boots  = animationFrame:CreateTexture(\"$parentbootsTexture\", \"BORDER\")\
        boots:SetTexture([[Interface\\AddOns\\Plater\\images\\icon_shoes.png]])\
        boots:SetDrawLayer(\"BORDER\", 0)\
        boots:SetPoint(\"center\", animationFrame, \"center\", -88, 35)\
        boots:SetSize(50, 50)\
        \
        --> animations for boots\
        \
        boots.alpha = bearTrapAnimation:CreateAnimation(\"ALPHA\")\
        boots.alpha:SetTarget(boots)\
        boots.alpha:SetOrder(1)\
        boots.alpha:SetDuration(0.31599998474121)\
        boots.alpha:SetFromAlpha(0)\
        boots.alpha:SetToAlpha(1)\
        boots.rotation = bearTrapAnimation:CreateAnimation(\"ROTATION\")\
        boots.rotation:SetTarget(boots)\
        boots.rotation:SetOrder(1)\
        boots.rotation:SetDuration(0.2960000038147)\
        boots.rotation:SetStartDelay(0.19999998807907)\
        boots.rotation:SetDegrees(40)\
        boots.rotation:SetOrigin(\"center\", 0, 0)\
        boots.translation = bearTrapAnimation:CreateAnimation(\"TRANSLATION\")\
        boots.translation:SetTarget(boots)\
        boots.translation:SetOrder(1)\
        boots.translation:SetDuration(0.59599995613098)\
        boots.translation:SetOffset(63, -33)\
        boots.translation = bearTrapAnimation:CreateAnimation(\"TRANSLATION\")\
        boots.translation:SetTarget(boots)\
        boots.translation:SetOrder(2)\
        boots.translation:SetDuration(0.046000000089407)\
        boots.translation:SetOffset(3, 3)\
        boots.translation = bearTrapAnimation:CreateAnimation(\"TRANSLATION\")\
        boots.translation:SetTarget(boots)\
        boots.translation:SetOrder(3)\
        boots.translation:SetDuration(0.046000000089407)\
        boots.translation:SetOffset(-3, -3)\
        boots.translation = bearTrapAnimation:CreateAnimation(\"TRANSLATION\")\
        boots.translation:SetTarget(boots)\
        boots.translation:SetOrder(4)\
        boots.translation:SetDuration(0.046000000089407)\
        boots.translation:SetOffset(3, 3)\
        boots.translation = bearTrapAnimation:CreateAnimation(\"TRANSLATION\")\
        boots.translation:SetTarget(boots)\
        boots.translation:SetOrder(5)\
        boots.translation:SetDuration(0.046000000089407)\
        boots.translation:SetOffset(-3, -3)\
        boots.alpha = bearTrapAnimation:CreateAnimation(\"ALPHA\")\
        boots.alpha:SetTarget(boots)\
        boots.alpha:SetOrder(6)\
        boots.alpha:SetDuration(0.39599999785423)\
        boots.alpha:SetFromAlpha(1)\
        boots.alpha:SetToAlpha(0)\
        \
        ----------------------------------------------\
        \
        unitFrame.BearTrapTextures = {leftTrap, rightTrap, boots}\
        unitFrame.BearTrapAnimationFrame = animationFrame\
        unitFrame.BearTrapAnimation = bearTrapAnimation\
        \
        \
        bearTrapAnimation:SetScript(\"OnPlay\", function()\
                boots:SetAlpha(0)\
                boots:Show()\
                leftTrap:Show()\
                rightTrap:Show()            \
        end)\
        \
        bearTrapAnimation:SetScript(\"OnFinished\", function()\
                boots:Hide()\
                leftTrap:Hide()\
                rightTrap:Hide()\
        end)       \
        \
        bearTrapAnimation:SetScript(\"OnStop\", function()\
                boots:Hide()\
                leftTrap:Hide()\
                rightTrap:Hide()\
        end)           \
        \
        \
    end\
    \
end\
\
\
\
\
",
