[30] = {
["Author"] = "Ditador-Azralon",
["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    --create a flash texture which keep blinking while the cast in going on\
    self.OGC_BlinkTexture = self.OGC_BlinkTexture or self:CreateTexture(nil, \"overlay\")\
    self.OGC_BlinkTexture:SetColorTexture(1, 1, 1)\
    self.OGC_BlinkTexture:SetAlpha(0)\
    \
    --create the animation group for the blinking texture\
    self.OGC_BlinkAnimation = self.OGC_BlinkAnimation or Plater:CreateAnimationHub(self.OGC_BlinkTexture, function() self.OGC_BlinkTexture:Show() end, function() self.OGC_BlinkTexture:Hide() end)\
    \
    self.OGC_BlinkAnimation.In = self.OGC_BlinkAnimation.In or Plater:CreateAnimation(self.OGC_BlinkAnimation, \"alpha\", 1, 0.5, 0.3, 1)\
    \
    self.OGC_BlinkAnimation.Out = self.OGC_BlinkAnimation.Out or Plater:CreateAnimation(self.OGC_BlinkAnimation, \"alpha\", 2, 0.5, 1, 0.2)    \
    \
    \
end\
\
\
",
["Desc"] = "The background of the nameplate blinks a red color indicating the cast is being performed. Useful to indicate channeling spells doing damage overtime.",
["Enabled"] = true,
["Icon"] = 4038101,
["Initialization"] = "\9\9function (scriptTable)\
\9\9\9--insert code here\
\9\9\9\
\9\9end\
\9",
["Name"] = "Cast - On Going Cast [P]",
["NpcNames"] = {
},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    self.OGC_BlinkAnimation:Stop()\
    \
    Plater.StopDotAnimation(self, envTable.dotAnimation1)    \
    Plater.StopDotAnimation(self, envTable.dotAnimation2)   \
    \
end\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    self.OGC_BlinkTexture:ClearAllPoints()\
    self.OGC_BlinkTexture:SetPoint(\"topleft\", self, \"topleft\", 0, 0)\
    self.OGC_BlinkTexture:SetPoint(\"bottomright\", self, \"bottomright\", 0, 0)\
    \
    local red, green, blue = Plater:ParseColors(scriptTable.config.blinkColor)\
    self.OGC_BlinkTexture:SetVertexColor(red, green, blue)\
    \
    local blinkSpeed = scriptTable.config.speed\
    \
    self.OGC_BlinkAnimation.In:SetDuration(blinkSpeed)\
    self.OGC_BlinkAnimation.Out:SetDuration(blinkSpeed)\
    \
    local minBlinkAlpha = scriptTable.config.minAlpha\
    local maxBlinkAlpha = scriptTable.config.maxAlpha\
    \
    self.OGC_BlinkAnimation.In:SetFromAlpha(minBlinkAlpha)\
    self.OGC_BlinkAnimation.In:SetToAlpha(maxBlinkAlpha)\
    self.OGC_BlinkAnimation.Out:SetFromAlpha(maxBlinkAlpha)    \
    self.OGC_BlinkAnimation.Out:SetToAlpha(minBlinkAlpha)\
    \
    self.OGC_BlinkAnimation:SetLooping(\"repeat\")\
    self.OGC_BlinkAnimation:Play()\
    \
    envTable.dotAnimation1 = Plater.PlayDotAnimation(self, 2, scriptTable.config.dotColor, scriptTable.config.xOffset, scriptTable.config.yOffset)\
    envTable.dotAnimation1.textureInfo.speedMultiplier = 0.3\
    \
    envTable.dotAnimation2 = Plater.PlayDotAnimation(self, 2, scriptTable.config.dotColor, scriptTable.config.xOffset, scriptTable.config.yOffset)\
    envTable.dotAnimation2.textureInfo.speedMultiplier = 1\
    \
end",
