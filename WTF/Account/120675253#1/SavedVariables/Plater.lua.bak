["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    local auraDuration = envTable._Duration\
    local altCastId = 1\
    \
    ---@class plater_altcastbarconfig : table\
    ---@field iconTexture string\
    ---@field iconTexcoord table\
    ---@field iconAlpha number\
    ---@field text string\
    ---@field texture any\
    ---@field color any\
    ---@field isChanneling boolean\
    ---@field canInterrupt boolean\
    ---@field height number\
    ---@field iconSize number\
    ---@field textSize number\
    ---@field spellNameAnchor df_anchor\
    ---@field timerAnchor df_anchor\
    ---@field iconAnchor df_anchor\
    \
    local configTable = {\
        iconTexture = envTable._Texture,\
        text = envTable._SpellName,\
        color = \"gray\",\
        isChanneling = true,\
        canInterrupt = false,\
        texture = [[Interface\\AddOns\\Plater\\images\\bar_background]],\
        \
    }\
    \
    Plater.SetAltCastBar(unitFrame.PlateFrame, configTable, auraDuration, envTable._StartTime, altCastId)\
    \
end\
\
