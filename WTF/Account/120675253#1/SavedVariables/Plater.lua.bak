    envTable.glowEffect:Show()\
    \
    envTable.BackgroundFlash:Play()\
    \
    Plater.FlashNameplateBorder (unitFrame, 0.05)   \
    Plater.FlashNameplateBody (unitFrame, \"\", 0.075)\
    \
    unitFrame:PlayFrameShake (envTable.FrameShake)\
    \
end\
\
\
