{
["OptionsValues"] = {
},
["HooksTemp"] = {
},
["UID"] = "0x6368e376137905",
["Hooks"] = {
["Nameplate Added"] = "function (self, unitId, unitFrame, envTable, modTable)\n    modTable.updateIcon(unitFrame)\nend",
["Initialization"] = "function (modTable)\n    \n    \n    --Settings:\n    local iconSize = abs(modTable.config.size) or 15\n    local icon = tonumber(modTable.config.icon) or 136243\n    local anchor = {\n        side = abs(modTable.config.anchor) or 8,\n        --1 = topleft 2 = left 3 = bottomleft 4 = bottom 5 = bottom right 6 = right 7 = topright 8 = top\n        x = abs(modTable.config.xoffset) or 0, --x offset\n        y = abs(modTable.config.yoffset) or 18, --y offset\n    }\n    local useBlizzardIcon = modTable.config.useBlizzardIcon\n    local showCustomIfNoBlizz = modTable.config.showCustomIfNoBlizz\n    local ignoreParentAlpha = modTable.config.ignoreParentAlpha\n    \n    function modTable.updateIcon(unitFrame)\n        if not unitFrame.softInteractIconIndicator then\n            unitFrame.softInteractIconIndicatorFrame = CreateFrame (\"frame\",unitFrame:GetName() .. \"softInteractIconIndicatorFrame\", unitFrame, BackdropTemplateMixin and \"BackdropTemplate\")\n            unitFrame.softInteractIconIndicator = unitFrame.softInteractIconIndicatorFrame:CreateTexture(nil, \"OVERLAY\")\n            unitFrame.softInteractIconIndicator:SetTexture(icon)\n            unitFrame.softInteractIconIndicator:Show()\n            unitFrame.softInteractIconIndicatorFrame:SetFrameLevel(unitFrame.healthBar:GetFrameLevel() + 25)\n            unitFrame.softInteractIconIndicatorFrame.Mask = unitFrame.softInteractIconIndicatorFrame:CreateMaskTexture(nil, \"OVERLAY\", nil, 1)\n            unitFrame.softInteractIconIndicatorFrame.Mask:Show()\n            unitFrame.softInteractIconIndicatorFrame.Mask:SetAtlas(\"CircleMaskScalable\", true)\n            --unitFrame.softInteractIconIndicatorFrame.Mask:SetScale(1)\n            unitFrame.softInteractIconIndicator:AddMaskTexture(unitFrame.softInteractIconIndicatorFrame.Mask)\n            unitFrame.softInteractIconIndicatorFrame.Mask:ClearAllPoints()\n            PixelUtil.SetPoint(unitFrame.softInteractIconIndicatorFrame.Mask, \"CENTER\", unitFrame.softInteractIconIndicatorFrame, \"CENTER\", 0, 0)\n            unitFrame.softInteractIconIndicatorFrame.Mask:SetAllPoints(unitFrame.softInteractIconIndicator)\n            unitFrame.softInteractIconIndicatorFrame:Hide()\n        end\n        \n        \n        if unitFrame.isSoftInteract then\n            if unitFrame.PlateFrame.IsNpcWithoutHealthBar then\n                Plater.SetAnchor(unitFrame.softInteractIconIndicator, anchor, unitFrame.PlateFrame)\n            else\n                Plater.SetAnchor(unitFrame.softInteractIconIndicator, anchor, unitFrame.healthBar)\n            end\n            unitFrame.softInteractIconIndicator:SetSize(iconSize, iconSize)\n            unitFrame.softInteractIconIndicator:SetDesaturated(modTable.config.desaturate)\n            unitFrame.softInteractIconIndicator:SetSize(iconSize, iconSize)\n            unitFrame.softInteractIconIndicator:SetIgnoreParentAlpha(ignoreParentAlpha)\n            unitFrame.softInteractIconIndicatorFrame:Show()\n            \n            if useBlizzardIcon then\n                local hasTexture =  SetUnitCursorTexture(unitFrame.softInteractIconIndicator, unitFrame.namePlateUnitToken, nil, true)\n                if not hasTexture and showCustomIfNoBlizz then\n                    unitFrame.softInteractIconIndicator:SetTexture(icon)\n                elseif not hasTexture then\n                    unitFrame.softInteractIconIndicatorFrame:Hide()\n                end\n            else\n                unitFrame.softInteractIconIndicator:SetTexture(icon)\n            end\n            \n        else\n            unitFrame.softInteractIconIndicatorFrame:Hide()\n        end\n    end\nend",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable, modTable)\n    modTable.updateIcon(unitFrame)\nend\n\n\n",
},
