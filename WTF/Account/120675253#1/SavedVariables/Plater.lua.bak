["Temp_UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    if (envTable._HealthPercent < 50) then\
        local alpha = DetailsFramework:MapRangeClamped(0, 50, 0.5, 0, envTable._HealthPercent)\
        \
        unitFrame.AddExplosionOnDieBackground:SetAlpha(alpha)\
    else\
        unitFrame.AddExplosionOnDieBackground:SetAlpha(0)\
    end\
    \
    if (envTable._HealthPercent < 15 and scriptTable.config.useShake) then\
        local shakeAmpliture = DetailsFramework:MapRangeClamped(0.001, 15, 10, 1, envTable._HealthPercent)\
        \
        unitFrame.AddExplosionOnDieShake.OriginalAmplitude = scriptTable.config.shakeAmplitude * shakeAmpliture\
        unitFrame.AddExplosionOnDieShake.OriginalFrequency = scriptTable.config.shakeFrequency\
        \
        unitFrame:PlayFrameShake (unitFrame.AddExplosionOnDieShake)\
    end\
    \
    \
end\
\
\
\
\
\
\
\
\
\
\
\
\
",
