},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    --insert code here\
    \
    local healthBar = unitFrame.healthBar\
    healthBar:SetReverseFill(false)\
    \
    if (unitFrame.AddExplosionOnDieShake) then\
        unitFrame:StopFrameShake (unitFrame.AddExplosionOnDieShake)    \
    end\
    \
    if (unitFrame.AddExplosionOnDieBackground) then\
        unitFrame.AddExplosionOnDieBackground:Hide()\
    end\
end\
\
\
\
\
\
\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    --insert code here\
    \
    local healthBar = unitFrame.healthBar\
    \
    if (scriptTable.config.useReverse) then\
        healthBar:SetReverseFill(true)\
    end\
    \
    --unitFrame.AddExplosionOnDieShake\
    \
    envTable.CreateWidgets()\
    \
    unitFrame.AddExplosionOnDieShake.OriginalAmplitude = scriptTable.config.shakeAmplitude\
    unitFrame.AddExplosionOnDieShake.OriginalDuration = 0.120\
    unitFrame.AddExplosionOnDieShake.OriginalFrequency = scriptTable.config.shakeFrequency\
    \
    if (scriptTable.config.useBackground) then\
        unitFrame.AddExplosionOnDieBackground:Show()\
        unitFrame.AddExplosionOnDieBackground:SetAlpha(0)\
    else\
        unitFrame.AddExplosionOnDieBackground:Hide()\
    end\
end\
\
\
\
\
\
\
",
