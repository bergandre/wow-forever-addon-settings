[37] = {
["Author"] = "Aelerolor-Torghast",
["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    function envTable.UpdateMarkers(unitFrame)\
        local npcID = envTable._NpcID\
        if not npcID then \
            if (unitFrame.healthMarker) then\
                unitFrame.healthMarker:Hide()\
                unitFrame.healthOverlay:Hide()\
            end\
            return \
        end\
        \
        local _, zoneType, diff = GetInstanceInfo()\
        local markersTable = zoneType == \"raid\" and scriptTable.Difficulty[diff][npcID] or scriptTable.lifePercent[npcID]\
        \
        if (markersTable) then\
            for _, p in ipairs(markersTable) do\
                if (envTable._HealthPercent > p) then\
                    local healthBar = unitFrame.healthBar\
                    local overlaySize = healthBar:GetWidth() * p/100\
                    \
                    if (not unitFrame.healthMarker) then\
                        unitFrame.healthMarker = healthBar:CreateTexture(nil, \"overlay\")\
                        unitFrame.healthMarker:SetColorTexture(1, 1, 1)\
                        unitFrame.healthOverlay = healthBar:CreateTexture(nil, \"overlay\")\
                        unitFrame.healthOverlay:SetColorTexture(1, 1, 1)\
                    end\
                    \
                    unitFrame.healthMarker:Show()\
                    unitFrame.healthMarker:SetSize(1, healthBar:GetHeight())\
                    unitFrame.healthMarker:SetPoint(\"left\", healthBar, \"left\", overlaySize, 0)\
                    unitFrame.healthMarker:SetVertexColor(Plater:ParseColors(scriptTable.config.indicatorColor))\
                    \
                    unitFrame.healthOverlay:Show()\
                    unitFrame.healthOverlay:SetSize(overlaySize, healthBar:GetHeight())\
                    unitFrame.healthOverlay:SetPoint(\"right\", unitFrame.healthMarker, \"left\", 0, 0)\
                    unitFrame.healthOverlay:SetVertexColor(Plater:ParseColors(scriptTable.config.fillColor))\
                    unitFrame.healthOverlay:SetAlpha(scriptTable.config.fillAlpha)\
                    \
                    return\
                end\
            end\
            \
            if (unitFrame.healthMarker) then\
                unitFrame.healthMarker:Hide()\
                unitFrame.healthOverlay:Hide()\
            end\
        end\
    end\
end",
["Desc"] = "Place a marker into the health bar to indicate when the unit will change phase or cast an important spell.",
["Enabled"] = true,
["Icon"] = "Interface\\Addons\\Plater\\images\\health_indicator",
