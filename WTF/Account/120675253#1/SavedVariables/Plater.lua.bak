["Name"] = "Cast - AoE Hit All [P]",
["NpcNames"] = {
},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    envTable.StopSwipeAnimation(unitFrame)\
end\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    envTable.CreateSwipeTextureAndAnimations(unitFrame)\
    \
    local options = scriptTable.config\
    \
    local targetScale = options.textureScale\
    \
    local circularTexture = unitFrame.CastSwipeTexture2\
    \
    --texture settings\
    circularTexture:SetTexture([[Interface\\AddOns\\Plater\\images\\cast_bar_circular_swipe2.png]])\
    circularTexture:SetPoint(\"center\", 0, 0)\
    circularTexture:SetSize(64, 64)    \
    circularTexture:SetBlendMode(\"ADD\")\
    circularTexture:SetVertexColor(DetailsFramework:ParseColors(options.textureColor))\
    circularTexture:SetScale(targetScale)\
    circularTexture:SetAlpha(options.textureAlpha)\
    \
    --animations    \
    unitFrame.CastSwipeAnimation2.Rotation:SetDuration(options.rotationDuration)\
    unitFrame.CastSwipeAnimation2.Trans:SetDuration(options.rotationDuration)\
    \
    local randomOffset = 5\
    unitFrame.CastSwipeAnimation2.Trans:SetOffset(math.random(-randomOffset, randomOffset), math.random(-randomOffset, randomOffset))\
    \
    \
    unitFrame.StartSwipeAnimation2.Alpha:SetDuration(options.animStartDuration)\
    unitFrame.StartSwipeAnimation2.Alpha:SetFromAlpha(options.textureStartAlpha)\
    unitFrame.StartSwipeAnimation2.Alpha:SetToAlpha(options.textureAlpha)\
    \
    unitFrame.StartSwipeAnimation2.Scale:SetDuration(options.animStartDuration)\
    unitFrame.StartSwipeAnimation2.Scale:SetScaleTo(targetScale, targetScale)\
    \
    unitFrame.EndSwipeAnimation2.Scale:SetDuration(0.1)\
    unitFrame.EndSwipeAnimation2.Alpha:SetDuration(0.1)\
    \
    --start playing\
    envTable.PlaySwipeAnimation(unitFrame)     \
    \
end\
\
\
\
\
",
