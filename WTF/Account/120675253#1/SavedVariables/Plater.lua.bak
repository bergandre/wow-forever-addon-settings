["Time"] = 1719679972,
["UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    local castBar = unitFrame.castBar\
    local textures = unitFrame.felAnimation.Textures\
    \
    if (envTable._CastPercent > envTable.NextPercent) then\
        local nextPercent = 100 / scriptTable.config.segmentsAmount\
        \
        textures[envTable.CurrentTexture]:Show()\
        textures[envTable.CurrentTexture].animGroup:Play()\
        \
        envTable.NextPercent = envTable.NextPercent + nextPercent \
        envTable.CurrentTexture = envTable.CurrentTexture + 1\
        \
        --print(envTable.NextPercent, envTable.CurrentTexture)\
        \
        if (envTable.CurrentTexture == #textures) then\
            envTable.NextPercent = 98\
        elseif (envTable.CurrentTexture > #textures) then\
            envTable.NextPercent = 999\
        end\
    end\
    \
    local normalizedPercent = envTable._CastPercent / 100\
    local textureStretched = unitFrame.felAnimation.textureStretched\
    local point = DetailsFramework:GetBezierPoint(normalizedPercent, 0, 0.001, 1)\
    textureStretched:SetPoint(\"left\", castBar, \"left\", point * envTable.castBarWidth, 0)\
    \
    self.ThrottleUpdate = 0\
end",
["semver"] = "",
["url"] = "",
["version"] = -1,
},
[51] = {
["Author"] = "Terciob",
["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    local DF = DetailsFramework\
    \
    function envTable.PlaySwipeAnimation(unitFrame)\
        unitFrame.CastSwipeTexture2:Show()\
        unitFrame.CastSwipeAnimation2:Play()\
        unitFrame.StartSwipeAnimation2:Play()\
    end\
    \
    function envTable.StopSwipeAnimation(unitFrame)\
        unitFrame.EndSwipeAnimation2:Play()\
        C_Timer.After(0.21, function()\
                unitFrame.CastSwipeAnimation2:Stop()\
                unitFrame.CastSwipeTexture2:Hide()\
        end)\
    end\
    \
    function envTable.CreateSwipeTextureAndAnimations(unitFrame)\
        if (unitFrame.CastSwipeTexture2) then\
            return\
        end\
        \
        local circularTexture = unitFrame:CreateTexture(nil, \"overlay\")\
        circularTexture:SetTexture([[Interface\\AddOns\\Plater\\images\\cast_bar_circular_swipe2.png]])\
        circularTexture:SetPoint(\"center\", 0, 0)\
        circularTexture:SetSize(64, 64)\
        circularTexture:Hide()\
        \
        unitFrame.CastSwipeTexture2 = circularTexture\
        \
        --rotation animation\
        unitFrame.CastSwipeAnimation2 = DF:CreateAnimationHub(circularTexture)\
        unitFrame.CastSwipeAnimation2:SetLooping(\"repeat\")\
        unitFrame.CastSwipeAnimation2.Rotation = DF:CreateAnimation(unitFrame.CastSwipeAnimation2, \"rotation\", 1, 1, 360)\
        unitFrame.CastSwipeAnimation2.Trans = DF:CreateAnimation(unitFrame.CastSwipeAnimation2, \"TRANSLATION\", 1, 1, 2, 2)\
        \
        --starting animation\
        unitFrame.StartSwipeAnimation2 = DF:CreateAnimationHub(circularTexture, function()circularTexture:Show() end)\
        \
        unitFrame.StartSwipeAnimation2.Alpha = DF:CreateAnimation(unitFrame.StartSwipeAnimation2, \"alpha\", 1, 0.2, 0, 1)\
        unitFrame.StartSwipeAnimation2.Scale = DF:CreateAnimation(unitFrame.StartSwipeAnimation2, \"scale\", 1, 0.2, 1.3, 1.3, 1, 1)        \
        \
        --finished animation\
        unitFrame.EndSwipeAnimation2 = DF:CreateAnimationHub(circularTexture, nil, function()circularTexture:Hide() end)\
        \
        unitFrame.EndSwipeAnimation2.Alpha = DF:CreateAnimation(unitFrame.EndSwipeAnimation2, \"alpha\", 1, 0.2, 1, 0)\
        \
        unitFrame.EndSwipeAnimation2.Scale = DF:CreateAnimation(unitFrame.EndSwipeAnimation2, \"scale\", 1, 0.2, 1, 1, 1.3, 1.3)\
        \
        \
    end\
    \
end\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
