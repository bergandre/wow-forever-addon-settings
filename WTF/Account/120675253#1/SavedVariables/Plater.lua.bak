[20] = {
["Author"] = "Huugg-Valdrakken",
["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    --insert code here\
    \
end\
\
\
",
["Desc"] = "Put a number above multiples adds, numbers follow their respawn id.",
["Enabled"] = false,
["Icon"] = "interface/addons/plater/images/add_id_icon",
["Initialization"] = "function (scriptTable)\
    \
    scriptTable.allAdds = {} \
    scriptTable.nextAddWave = 0\
    scriptTable.waveTime = 20\
    \
    function scriptTable.ArrangeNpcNumbers(GUID)\
        local spawnId = select(7, strsplit (\"-\", GUID))\
        spawnId = tonumber(spawnId, 16)\
        \
        if (spawnId) then\
            --check if this is a new wave of adds\
            if (GetTime() > scriptTable.nextAddWave) then\
                scriptTable.nextAddWave = GetTime() + scriptTable.waveTime\
                scriptTable.allAdds = {}\
            end\
            \
            local bIsAlreadyOnTheList = false\
            \
            for o = 1, #scriptTable.allAdds do\
                if (scriptTable.allAdds[o][1] == GUID) then\
                    bIsAlreadyOnTheList = true\
                end\
            end\
            \
            if (not bIsAlreadyOnTheList) then\
                scriptTable.allAdds[#scriptTable.allAdds+1] = {GUID, spawnId}\
            end\
        end\
        \
        table.sort(scriptTable.allAdds, function(t1, t2) return t1[2] < t2[2] end)\
        \
        --this is a \"loop\" because this is running each time a nameplate is added!\
        \
        for namePlateIndex, plateFrame in ipairs(Plater.GetAllShownPlates()) do\
            local unitFrame = plateFrame.unitFrame\
            \
            --get the unit GUID\
            local unitGUID = unitFrame.namePlateUnitGUID\
            \
            for addId = 1, #scriptTable.allAdds do\
                local addTable = scriptTable.allAdds[addId]\
                local addGUID = addTable[1]\
                \
                if (unitGUID == addGUID) then\
                    scriptTable.TagNameplate(unitFrame, unitGUID, addId)\
                    break\
                end\
            end\
            \
        end\
    end\
    \
    function scriptTable.TagNameplate(unitFrame, GUID, addId)\
        scriptTable.CreateAddWidgetsForNameplate(unitFrame, GUID, addId)\
        \
        if (addId and addId >= 1 and addId <= 8) then\
            unitFrame.AddSpawnIDTexture:Show()\
            unitFrame.AddIcon:Show()\
            unitFrame.AddNumber:Show()\
            \
            local addTexture = \"Interface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_\" .. addId\
            \
            unitFrame.AddIcon:SetTexture(addTexture)\
            unitFrame.AddNumber:SetText(addId)\
        end\
    end\
    \
    function scriptTable.CreateAddWidgetsForNameplate(unitFrame, GUID, addId)\
        if (not unitFrame.AddSpawnIDTexture) then\
            local healthBar = unitFrame.healthBar\
            \
            local textureBackground = healthBar.FrameOverlay:CreateTexture(nil, \"overlay\", nil, 5)\
            local addIcon = healthBar.FrameOverlay:CreateTexture(nil, \"overlay\", nil, 6)\
            local addNumber = healthBar.FrameOverlay:CreateFontString(nil, \"overlay\", \"GameFontNormal\", 6)           \
            \
            unitFrame.AddSpawnIDTexture = textureBackground\
            unitFrame.AddIcon = addIcon\
            unitFrame.AddNumber = addNumber\
        end\
    end    \
end\
\
--Creature-0-2085-1-11042-153285-0002F8DB2B --training dummy for testing\
--195138 Detonating Crystal\
--192955 dracomoc illusion\
--190294 nokhub stormcaster\
--76518 ritual of bones\
\
\
\
\
