["Temp_UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    if (UnitIsUnit(unitId .. \"target\", \"player\")) then\
        Plater.SetNameplateColor(unitFrame, scriptTable.config.nameplateColor)\
    else\
        Plater.RefreshNameplateColor(unitFrame)\
    end\
end\
\
\
