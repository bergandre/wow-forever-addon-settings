[32] = {
["Author"] = "Viash-Thrall",
["Desc"] = "Adds an icon to the nameplate if it is your current soft-interact target.",
["Enabled"] = true,
["Hooks"] = {
["Initialization"] = "function (modTable)\
    \
    \
    --Settings:\
    local iconSize = abs(modTable.config.size) or 15\
    local icon = tonumber(modTable.config.icon) or 136243\
    local anchor = {\
        side = abs(modTable.config.anchor) or 8,\
        --1 = topleft 2 = left 3 = bottomleft 4 = bottom 5 = bottom right 6 = right 7 = topright 8 = top\
        x = abs(modTable.config.xoffset) or 0, --x offset\
        y = abs(modTable.config.yoffset) or 18, --y offset\
    }\
    local useBlizzardIcon = modTable.config.useBlizzardIcon\
    local showCustomIfNoBlizz = modTable.config.showCustomIfNoBlizz\
    local ignoreParentAlpha = modTable.config.ignoreParentAlpha\
    \
    function modTable.updateIcon(unitFrame)\
        if not unitFrame.softInteractIconIndicator then\
            unitFrame.softInteractIconIndicatorFrame = CreateFrame (\"frame\",unitFrame:GetName() .. \"softInteractIconIndicatorFrame\", unitFrame, BackdropTemplateMixin and \"BackdropTemplate\")\
            unitFrame.softInteractIconIndicator = unitFrame.softInteractIconIndicatorFrame:CreateTexture(nil, \"OVERLAY\")\
            unitFrame.softInteractIconIndicator:SetTexture(icon)\
            unitFrame.softInteractIconIndicator:Show()\
            unitFrame.softInteractIconIndicatorFrame:SetFrameLevel(unitFrame.healthBar:GetFrameLevel() + 25)\
            unitFrame.softInteractIconIndicatorFrame.Mask = unitFrame.softInteractIconIndicatorFrame:CreateMaskTexture(nil, \"OVERLAY\", nil, 1)\
            unitFrame.softInteractIconIndicatorFrame.Mask:Show()\
            unitFrame.softInteractIconIndicatorFrame.Mask:SetAtlas(\"CircleMaskScalable\", true)\
            --unitFrame.softInteractIconIndicatorFrame.Mask:SetScale(1)\
            unitFrame.softInteractIconIndicator:AddMaskTexture(unitFrame.softInteractIconIndicatorFrame.Mask)\
            unitFrame.softInteractIconIndicatorFrame.Mask:ClearAllPoints()\
            PixelUtil.SetPoint(unitFrame.softInteractIconIndicatorFrame.Mask, \"CENTER\", unitFrame.softInteractIconIndicatorFrame, \"CENTER\", 0, 0)\
            unitFrame.softInteractIconIndicatorFrame.Mask:SetAllPoints(unitFrame.softInteractIconIndicator)\
            unitFrame.softInteractIconIndicatorFrame:Hide()\
        end\
        \
        \
        if unitFrame.isSoftInteract then\
            if unitFrame.PlateFrame.IsNpcWithoutHealthBar then\
                Plater.SetAnchor(unitFrame.softInteractIconIndicator, anchor, unitFrame.PlateFrame)\
            else\
                Plater.SetAnchor(unitFrame.softInteractIconIndicator, anchor, unitFrame.healthBar)\
            end\
            unitFrame.softInteractIconIndicator:SetSize(iconSize, iconSize)\
            unitFrame.softInteractIconIndicator:SetDesaturated(modTable.config.desaturate)\
            unitFrame.softInteractIconIndicator:SetSize(iconSize, iconSize)\
            unitFrame.softInteractIconIndicator:SetIgnoreParentAlpha(ignoreParentAlpha)\
            unitFrame.softInteractIconIndicatorFrame:Show()\
            \
            if useBlizzardIcon then\
                local hasTexture =  SetUnitCursorTexture(unitFrame.softInteractIconIndicator, unitFrame.namePlateUnitToken, nil, true)\
                if not hasTexture and showCustomIfNoBlizz then\
                    unitFrame.softInteractIconIndicator:SetTexture(icon)\
                elseif not hasTexture then\
                    unitFrame.softInteractIconIndicatorFrame:Hide()\
                end\
            else\
                unitFrame.softInteractIconIndicator:SetTexture(icon)\
            end\
            \
        else\
            unitFrame.softInteractIconIndicatorFrame:Hide()\
        end\
    end\
end",
["Nameplate Added"] = "function (self, unitId, unitFrame, envTable, modTable)\
    modTable.updateIcon(unitFrame)\
end",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable, modTable)\
    modTable.updateIcon(unitFrame)\
end\
\
\
",
},
