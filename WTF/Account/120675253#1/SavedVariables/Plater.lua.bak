",
["Options"] = {
},
["PlaterCore"] = 1,
["Revision"] = 83,
["ScriptType"] = 1,
["SpellIds"] = {
[1] = 343470,
[2] = 423228,
},
["Time"] = 1725033998,
["UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    if (WOW_PROJECT_ID ~= WOW_PROJECT_MAINLINE) then\
        return \
    end\
    \
    local continuationToken\
    local slots\
    local foundAura = false\
    \
    for i = 1, 40 do\
        local auraInfo = C_UnitAuras.GetBuffDataByIndex(envTable._UnitID, i)\
        if (auraInfo) then\
            local spellId = auraInfo.spellId\
            if (spellId == envTable._SpellID) then --need to get the trigger spellId\
                --Ablative Shield\
                local unitPowerBar = unitFrame.powerBar\
                if (not unitPowerBar:IsShown()) then\
                    unitPowerBar:SetUnit(unitId)\
                end\
                \
                foundAura = true\
                return\
            end\
        else\
            break\
        end\
    end\
    \
    if (not foundAura) then\
        local unitPowerBar = unitFrame.powerBar\
        if (unitPowerBar:IsShown()) then\
            unitPowerBar:Hide()\
        end\
    end\
end",
["semver"] = "",
["url"] = "",
["version"] = -1,
},
