[3] = 384933,
},
["Time"] = 1673726734,
["UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    if (Plater.UnitIsCasting(unitId)) then\
        envTable.ShowBackground(unitFrame)\
    else\
        envTable.HideBackground(unitFrame)\
    end\
    \
end",
