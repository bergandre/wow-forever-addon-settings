    self.BigSparkle:SetPoint (\"topleft\", unitFrame.healthBar, \"topleft\", unitFrame.healthBar:GetWidth() * (envTable._CastPercent / 100) - 4, 0)\
    \
    if (scriptTable.config.useNameplateColor) then\
        Plater.SetNameplateColor(unitFrame, envTable.NameplateColor)\
    end\
    \
