},
["aura_stack_shadow_color"] = {
[4] = 0,
},
["minor_height_scale"] = 0.9999999403953552,
["bossmod_cooldown_text_size"] = 14,
["aura_padding"] = 0.5,
["indicator_worldboss"] = false,
["hook_data"] = {
{
["Enabled"] = true,
["Revision"] = 320,
["Options"] = {
},
["HooksTemp"] = {
},
["Author"] = "Luckyone-Laughing Skull",
["LastHookEdited"] = "Nameplate Updated",
["Desc"] = "",
["Hooks"] = {
["Initialization"] = "function(modTable)\n    \n    -- Last update by Luckyone: August 10, 2025\n    \n    local Retail = WOW_PROJECT_ID == WOW_PROJECT_MAINLINE\n    local Mists = WOW_PROJECT_ID == WOW_PROJECT_MISTS_CLASSIC\n    local IsRetailOrMists = Retail or Mists\n    \n    -- List of NPC ids\n    -- if you want to see their first name instead\n    modTable.firstName = {\n        -- Totems\n        [3527] = true, -- Healing Stream\n        [2630] = true, -- Earthbind\n        [61245] = true, -- Capacitor\n        [5925] = true, -- Grounding\n        [105451] = true, -- Counterstrike\n        [105427] = true, -- Skyfury\n        [97369] = true, -- Liquid Magma\n        -- Mists\n        [59915] = true, -- Jasper Guardian\n        [60051] = true, -- Cobalt Guardian\n        [60047] = true, -- Amethyst Guardian\n        -- Retail\n        [207796] = true, -- Burning Colossus\n        [214012] = true, -- Dark Colossus\n    }\n    \n    -- List of NPC ids\n    -- if you want to see their full name instead\n    modTable.fullName = {\n        -- [123456] = true,\n    }\n    \n    modTable.isMaxLevel = IsLevelAtEffectiveMaxLevel(UnitLevel('player'))\n    \n    local function Hex(r, g, b)\n        if type(r) == 'table' then\n            r, g, b = r.r or r[1], r.g or r[2], r.b or r[3]\n        end\n        \n        return (r and type(r) ~= 'string') and format('|cff%02x%02x%02x', r * 255, g * 255, b * 255) or '|cffFFFFFF'\n    end\n    \n    function level(unitId)\n        if modTable.isMaxLevel then return false end\n        \n        local level, color\n        \n        if IsRetailOrMists and (UnitIsWildBattlePet(unitId) or UnitIsBattlePetCompanion(unitId)) then\n            level = UnitBattlePetLevel(unitId)\n            local teamLevel = C_PetJournal.GetPetTeamAverageLevel()\n            color = (teamLevel ~= level) and GetRelativeDifficultyColor(teamLevel, level) or QuestDifficultyColors.difficult\n        else\n            level = UnitEffectiveLevel(unitId)\n            color = GetCreatureDifficultyColor(level)\n        end\n        \n        return format('%s%s|r - ', Hex(color), (level > 0) and level or '??')\n    end\n    \n    modTable.level = level\n    modTable.IsRetailOrMists = IsRetailOrMists\nend",
["Nameplate Updated"] = "function(self, unitId, unitFrame, envTable, modTable)\n    \n    local unitName = UnitName(unitId)\n    if not unitName then return end\n    \n    local npcId = unitFrame.namePlateNpcId\n    local displayName\n    \n    -- Ensure namePrefix is never nil\n    local namePrefix = modTable.level(unitId) or ''\n    \n    if modTable.firstName[npcId] then\n        -- Extract first word, fallback to full name if pattern fails\n        local firstName = unitName:match('^(%S+)') or unitName\n        displayName = namePrefix .. firstName\n    elseif modTable.fullName[npcId] then\n        displayName = namePrefix .. unitName\n    else\n        -- Extract last word, fallback to full name if pattern fails\n        local lastName = unitName:match('(%S+)%s*$') or unitName\n        displayName = namePrefix .. lastName\n    end\n    \n    unitFrame.healthBar.unitName:SetText(displayName)\nend",
},
["Prio"] = 1,
["Time"] = 1755240413,
["LoadConditions"] = {
["talent"] = {
},
["group"] = {
},
["affix"] = {
},
["map_ids"] = {
},
["race"] = {
