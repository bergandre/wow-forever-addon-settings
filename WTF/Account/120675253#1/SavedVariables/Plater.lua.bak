["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    Plater.DenyColorChange(unitFrame, false)\
    unitFrame.onShowAddToKillFlash:Stop()\
    \
end\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    unitFrame.onShowAddToKillFlash = unitFrame.onShowAddToKillFlash or Plater.CreateFlash (unitFrame.healthBar, 0.25, 1, \"white\")\
    \
    if (scriptTable.config.useFlash) then\
        unitFrame.onShowAddToKillFlash:Play()\
    end\
    \
    if (scriptTable.config.useNameplateColor) then\
        local npcIdString = tostring(envTable._NpcID)\
        envTable.NameplateColor = Plater.GetColorByPriority(unitFrame, scriptTable.config.npcColor[npcIdString], scriptTable.config.healthBarColor)\
        Plater.DenyColorChange(unitFrame, true)\
    end\
end\
\
\
\
\
\
\
\
\
\
",
