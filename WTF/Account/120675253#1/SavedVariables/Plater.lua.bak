{
["Enabled"] = true,
["Revision"] = 1,
["OptionsValues"] = {
},
["LastHookEdited"] = "Nameplate Updated",
["Author"] = "Karums",
["Options"] = {
},
["Desc"] = "Execute range (< 20%) turns the bar green. Custom for WoW Forever.",
["Hooks"] = {
["Constructor"] = "function (self, unitId, unitFrame, envTable)\n    -- Forever runs Plater's \"midnight\" code: InExecuteRange is never set there.\n    -- Force a 20% execute range even if Plater does not detect Execute, once per session.\n    if not Plater.__ExecuteGreenHooked then\n        Plater.__ExecuteGreenHooked = true\n        local orig = Plater.GetHealthCutoffValue\n        Plater.GetHealthCutoffValue = function(getOnly)\n            if getOnly then\n                local low, high = orig(true)\n                return low or 0.2, high\n            end\n            orig()\n            if not orig(true) then\n                Plater.SetExecuteRange(true, 0.2)\n            end\n        end\n        Plater.GetHealthCutoffValue()\n    end\nend\n",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable)\n    -- Plater fades its execute zone (0-20% of the bar) in only while in execute range.\n    -- Make it bright green and draw it above the health fill, so the bar looks green.\n    local zone = unitFrame.healthBar and unitFrame.healthBar.executeRange\n    if zone then\n        zone:SetDrawLayer(\"OVERLAY\", 6)\n        zone:SetVertexColor(0.1, 1, 0.1)\n    end\nend\n",
},
["Prio"] = 99,
["Name"] = "Execute Green",
