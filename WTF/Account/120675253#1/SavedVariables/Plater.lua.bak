    if (unitFrame.spitefulTexture) then\
        unitFrame.spitefulText:Hide()\
        unitFrame.spitefulTexture:Hide()    \
        unitFrame.roleIcon:Hide()\
        unitFrame.targetName:Hide()\
    end\
end\
\
\
\
\
\
