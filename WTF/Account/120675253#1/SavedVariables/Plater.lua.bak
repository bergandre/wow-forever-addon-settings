["Name"] = "Aura is Shield [P]",
["NpcNames"] = {
},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    --insert code here\
    local unitPowerBar = unitFrame.powerBar\
    unitPowerBar:Hide()\
end\
