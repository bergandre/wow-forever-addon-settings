\
",
["Name"] = "Cast - Important by Color [P]",
["NpcNames"] = {
},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    Plater.StopDotAnimation(unitFrame.healthBar, envTable.dotAnimation)\
    \
    envTable.overlaySpark:Hide()\
    self.BigSparkle:Hide()\
    \
    Plater.RefreshNameplateColor (unitFrame)\
    \
    envTable.smallScaleAnimation:Stop()\
    \
    --increase the nameplate size\
    local nameplateHeight = Plater.db.profile.plate_config.enemynpc.health_incombat [2]\
    unitFrame.healthBar:SetHeight (nameplateHeight)\
    \
    Plater.DenyColorChange(unitFrame, false)\
end\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    envTable.overlaySpark:Show()\
    \
    self.BigSparkle:Show()\
    self.BigSparkle:SetWidth(8)\
    self.BigSparkle:SetHeight(self:GetHeight() + unitFrame.healthBar:GetHeight())\
    self.BigSparkle:SetScale(1)\
    self.BigSparkle:SetVertexColor(1,1, 1, 1)\
    envTable.overlaySpark:Hide()\
    \
    self.Spark:Hide()\
    \
    \
    Plater.FlashNameplateBorder (unitFrame, 0.05)   \
    Plater.FlashNameplateBody (unitFrame, \"\", 0.075)\
    \
    envTable.smallScaleAnimation:Play()\
    \
    --increase the nameplate size\
    local nameplateHeight = Plater.db.profile.plate_config.enemynpc.health_incombat [2]\
    unitFrame.healthBar:SetHeight (nameplateHeight + envTable.NameplateSizeOffset)\
    \
    envTable.overlaySpark.height = nameplateHeight + 5\
    \
    envTable.dotAnimation = Plater.PlayDotAnimation(unitFrame.healthBar, 2, scriptTable.config.dotColor, scriptTable.config.xOffset, scriptTable.config.yOffset)\
    \
    envTable.dotAnimation:SetPoint(\"bottomright\", self, \"bottomright\", scriptTable.config.xOffset, -scriptTable.config.yOffset)\
    \
    \
    local customColor = scriptTable.config.castColor[tostring(envTable._SpellID)]\
    \
    Plater.SetCastBarColorForScript(self, scriptTable.config.useCastbarColor, customColor or scriptTable.config.castBarColor, envTable)\
    \
    if (scriptTable.config.useNameplateColor) then\
        local npcIdString = tostring(envTable._NpcID)\
        envTable.NameplateColor = Plater.GetColorByPriority(unitFrame, scriptTable.config.healthBarColor)        \
        Plater.DenyColorChange(unitFrame, true)            \
    end\
    \
end",
