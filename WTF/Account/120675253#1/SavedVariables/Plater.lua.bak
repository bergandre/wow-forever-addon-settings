102019 = Stormforged Obliterator\
    187159 = Shrieking Whelp\
194897 = stormsurge totem\
104251 = duskwatch sentry\
101326 = honored ancestor\
189669 = binding speakl netharius\
192464 = raging ember neltharius\
--]=]\
\
\
