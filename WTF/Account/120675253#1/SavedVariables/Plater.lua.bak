[16] = {
["Author"] = "Karums",
["Desc"] = "Execute range (< 20%) turns the bar green. Custom for WoW Forever.",
["Enabled"] = true,
["Hooks"] = {
["Constructor"] = "function (self, unitId, unitFrame, envTable)\
    -- Forever runs Plater's \"midnight\" code: InExecuteRange is never set there.\
    -- Force a 20% execute range even if Plater does not detect Execute, once per session.\
    if not Plater.__ExecuteGreenHooked then\
        Plater.__ExecuteGreenHooked = true\
        local orig = Plater.GetHealthCutoffValue\
        Plater.GetHealthCutoffValue = function(getOnly)\
            if getOnly then\
                local low, high = orig(true)\
                return low or 0.2, high\
            end\
            orig()\
            if not orig(true) then\
                Plater.SetExecuteRange(true, 0.2)\
            end\
        end\
        Plater.GetHealthCutoffValue()\
    end\
end\
",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable)\
    -- Plater fades its execute zone (0-20% of the bar) in only while in execute range.\
    -- Make it bright green and draw it above the health fill, so the bar looks green.\
    local zone = unitFrame.healthBar and unitFrame.healthBar.executeRange\
    if zone then\
        zone:SetDrawLayer(\"OVERLAY\", 6)\
        zone:SetVertexColor(0.1, 1, 0.1)\
    end\
end\
",
},
["HooksTemp"] = {
["Constructor"] = "function (self, unitId, unitFrame, envTable)\
    -- Forever runs Plater's \"midnight\" code: InExecuteRange is never set there.\
    -- Force a 20% execute range even if Plater does not detect Execute, once per session.\
    if not Plater.__ExecuteGreenHooked then\
        Plater.__ExecuteGreenHooked = true\
        local orig = Plater.GetHealthCutoffValue\
        Plater.GetHealthCutoffValue = function(getOnly)\
            if getOnly then\
                local low, high = orig(true)\
                return low or 0.2, high\
            end\
            orig()\
            if not orig(true) then\
                Plater.SetExecuteRange(true, 0.2)\
            end\
        end\
        Plater.GetHealthCutoffValue()\
    end\
end\
",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable)\
    -- Plater fades its execute zone (0-20% of the bar) in only while in execute range.\
    -- Make it bright green and draw it above the health fill, so the bar looks green.\
    local zone = unitFrame.healthBar and unitFrame.healthBar.executeRange\
    if zone then\
        zone:SetDrawLayer(\"OVERLAY\", 6)\
        zone:SetVertexColor(0.1, 1, 0.1)\
    end\
end\
",
},
