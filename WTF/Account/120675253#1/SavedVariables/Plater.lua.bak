["UpdateCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    --update the percent\
    envTable.overlaySpark:SetPoint (\"left\", unitFrame.healthBar:GetWidth() * (envTable._CastPercent / 100)-9, 0)\
    \
    envTable.topArrow:SetPoint (\"bottomleft\", unitFrame.healthBar, \"topleft\", unitFrame.healthBar:GetWidth() * (envTable._CastPercent / 100) - 4, 2 )\
    \
    --forces the script to run the update as fast as the game framerate\
    self.ThrottleUpdate = 0\
    \
    if (scriptTable.config.useNameplateColor) then\
        Plater.SetNameplateColor(unitFrame, envTable.NameplateColor)\
    end\
    \
    --local dotSpeed = abs(envTable._Duration - envTable._RemainingTime) + 1.5\
    --envTable.dotAnimation.textureInfo.speedMultiplier = dotSpeed\
end\
\
\
\
\
",
["semver"] = "",
["url"] = "",
["version"] = -1,
},
[32] = {
["Author"] = "Terciob",
["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    --insert code here\
    \
    if (not self.FrameOverlay.LeapArrow1) then\
        \
        self.FrameOverlay.LeapArrow1 = self.FrameOverlay:CreateTexture(nil, \"overlay\")\
        self.FrameOverlay.LeapArrow2 = self.FrameOverlay:CreateTexture(nil, \"overlay\")\
        self.FrameOverlay.LeapArrow3 = self.FrameOverlay:CreateTexture(nil, \"overlay\")\
        \
        local onPlayFunc = function()\
            --self.FrameOverlay.LeapArrow1:Show()\
            --self.FrameOverlay.LeapArrow2:Show()\
            --self.FrameOverlay.LeapArrow3:Show()            \
        end\
        local onStopFunc = function()\
            self.FrameOverlay.LeapArrow1:Hide()\
            self.FrameOverlay.LeapArrow2:Hide()\
            self.FrameOverlay.LeapArrow3:Hide()\
        end\
        \
        --first arrow animation\
        local animHub1 = DetailsFramework:CreateAnimationHub (self.FrameOverlay.LeapArrow1, onPlayFunc, onStopFunc)\
        animHub1.alpha1 = DetailsFramework:CreateAnimation (animHub1, \"alpha\", 1, 0.3, 0, 0.8)\
        animHub1.trans1 = DetailsFramework:CreateAnimation (animHub1, \"translation\", 1, 0.3, 8, 8)\
        \
        animHub1.alpha2 = DetailsFramework:CreateAnimation (animHub1, \"alpha\", 2, 0.3, 0.8, 0)\
        animHub1.trans2 = DetailsFramework:CreateAnimation (animHub1, \"translation\", 2, 0.3, 8, 8)        \
        \
        self.FrameOverlay.LeapArrow1.animation = animHub1\
        \
        --second arrow animation\
        local animHub2 = DetailsFramework:CreateAnimationHub (self.FrameOverlay.LeapArrow2, onPlayFunc, onStopFunc)\
        animHub2.alpha1 = DetailsFramework:CreateAnimation (animHub2, \"alpha\", 1, 0.3, 0, 0.8)\
        animHub2.trans1 = DetailsFramework:CreateAnimation (animHub2, \"translation\", 1, 0.3, 8, 8)\
        \
        animHub2.alpha2 = DetailsFramework:CreateAnimation (animHub2, \"alpha\", 2, 0.3, 0.8, 0)\
        animHub2.trans2 = DetailsFramework:CreateAnimation (animHub2, \"translation\", 2, 0.3, 8, 8)\
        \
        self.FrameOverlay.LeapArrow2.animation = animHub2\
        \
        --third arrow animation\
        local animHub3 = DetailsFramework:CreateAnimationHub (self.FrameOverlay.LeapArrow3, onPlayFunc, onStopFunc)\
        animHub3.alpha1 = DetailsFramework:CreateAnimation (animHub3, \"alpha\", 1, 0.3, 0, 0.8)\
        animHub3.trans1 = DetailsFramework:CreateAnimation (animHub3, \"translation\", 1, 0.3, 8, 8)\
        \
        animHub3.alpha2 = DetailsFramework:CreateAnimation (animHub3, \"alpha\", 2, 0.3, 0.8, 0)\
        animHub3.trans2 = DetailsFramework:CreateAnimation (animHub3, \"translation\", 2, 0.3, 8, 8)\
        \
        self.FrameOverlay.LeapArrow3.animation = animHub3\
        \
        self.FrameOverlay.LeapArrowTextures = {\
            self.FrameOverlay.LeapArrow1,\
            self.FrameOverlay.LeapArrow2,\
            self.FrameOverlay.LeapArrow3\
        }\
        \
        self.FrameOverlay.LeapArrowAnimations = {\
            alpha1Anim = {},\
            alpha2Anim = {},\
            trans1Anim = {},\
            trans2Anim = {},\
        }\
        \
        self.FrameOverlay.LeapArrowAnimations.alpha1Anim = {animHub1.alpha1, animHub2.alpha1, animHub3.alpha1}\
        self.FrameOverlay.LeapArrowAnimations.alpha2Anim = {animHub1.alpha2, animHub2.alpha2, animHub3.alpha2}\
        self.FrameOverlay.LeapArrowAnimations.trans1Anim = {animHub1.trans1, animHub2.trans1, animHub3.trans1}\
        self.FrameOverlay.LeapArrowAnimations.trans2Anim = {animHub1.trans2, animHub2.trans2, animHub3.trans2}        \
        \
    end\
    \
end\
\
\
\
\
\
\
",
["Desc"] = "Modify a cast bar when the unit casts a spell with the same effect of the Warrior's Heroic Leap spell.",
["Enabled"] = true,
["Icon"] = 236171,
["Initialization"] = "function (scriptTable)\
    --insert code here\
    \
end",
["Name"] = "Cast - Heroic Leap [P]",
["NpcNames"] = {
},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    ---@type texture[]\
    local leapTextures = self.FrameOverlay.LeapArrowTextures\
    \
    for i, texture in ipairs(leapTextures) do\
        texture:Hide()\
        local animation = texture.animation\
        animation:Stop()\
    end    \
    \
end\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    if (scriptTable.config.bUseCastbarColor) then\
        Plater.SetCastBarColor (unitFrame, DetailsFramework:ParseColors(scriptTable.config.castbarColor))\
    end\
    \
    \
    if (scriptTable.config.bRenameSpell) then\
        self.Text:SetText(scriptTable.config.spellName) \
    end\
    \
    ---@type texture[]\
    local leapTextures = self.FrameOverlay.LeapArrowTextures\
    for i, texture in ipairs(leapTextures) do\
        texture:SetTexture([[Interface\\AddOns\\Plater\\media\\arrow_right_64.tga]])\
        texture:ClearAllPoints()\
        texture:SetSize(self:GetHeight()*1.5, self:GetHeight()*1.5)\
        texture:SetRotation(math.pi - math.pi*0.75)        \
    end\
    \
    local startX = -10\
    leapTextures[1]:SetPoint(\"left\", self, \"left\", startX, -8)\
    leapTextures[2]:SetPoint(\"center\", self, \"center\", startX, -8)\
    leapTextures[3]:SetPoint(\"right\", self, \"right\", startX, -8)\
    \
    local animations = self.FrameOverlay.LeapArrowAnimations\
    local alpha1Animations = animations.alpha1Anim\
    local alpha2Animations = animations.alpha2Anim    \
    local trans1Animations = animations.trans1Anim\
    local trans2Animations = animations.trans2Anim    \
    \
    local castTime = envTable._Duration\
    \
    --on fade in\
    local fadeInDuration =  castTime/6\
    \
    C_Timer.After(fadeInDuration, function()\
            for i, texture in ipairs(leapTextures) do\
                texture:SetRotation(-math.pi*0.25)\
                --texture:Show()\
            end            \
    end)\
    \
    for i, alphaAnim in ipairs(alpha1Animations) do\
        alphaAnim:SetDuration(fadeInDuration)\
        alphaAnim:SetFromAlpha(0.3)\
        alphaAnim:SetToAlpha(1)\
    end\
    \
    for i, transAnim in ipairs(trans1Animations) do\
        transAnim:SetDuration(fadeInDuration)\
        transAnim:SetOffset(8, 20)\
    end\
    \
    --on fade out\
    local fadeOutDuration = castTime/2\
    \
    for i, alphaAnim in ipairs(alpha2Animations) do\
        alphaAnim:SetDuration(fadeOutDuration)\
        alphaAnim:SetFromAlpha(1)\
        alphaAnim:SetToAlpha(0.3)\
    end\
    \
    for i, transAnim in ipairs(trans2Animations) do\
        transAnim:SetDuration(fadeOutDuration)\
        transAnim:SetOffset(8, -16)\
    end    \
    \
    for i, texture in ipairs(leapTextures) do\
        texture:Show()\
        local animation = texture.animation\
        animation:Play()\
    end\
    \
    \
    --DetailsFramework:DebugVisibility(self.FrameOverlay.LeapArrow1)\
end",
