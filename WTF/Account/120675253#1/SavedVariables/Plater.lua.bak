["hook_data"] = {
[1] = {
["Author"] = "Luckyone-Laughing Skull",
["Desc"] = "",
["Enabled"] = true,
["Hooks"] = {
["Initialization"] = "function(modTable)\
    \
    -- Last update by Luckyone: August 10, 2025\
    \
    local Retail = WOW_PROJECT_ID == WOW_PROJECT_MAINLINE\
    local Mists = WOW_PROJECT_ID == WOW_PROJECT_MISTS_CLASSIC\
    local IsRetailOrMists = Retail or Mists\
    \
    -- List of NPC ids\
    -- if you want to see their first name instead\
    modTable.firstName = {\
        -- Totems\
        [3527] = true, -- Healing Stream\
        [2630] = true, -- Earthbind\
        [61245] = true, -- Capacitor\
        [5925] = true, -- Grounding\
        [105451] = true, -- Counterstrike\
        [105427] = true, -- Skyfury\
        [97369] = true, -- Liquid Magma\
        -- Mists\
        [59915] = true, -- Jasper Guardian\
        [60051] = true, -- Cobalt Guardian\
        [60047] = true, -- Amethyst Guardian\
        -- Retail\
        [207796] = true, -- Burning Colossus\
        [214012] = true, -- Dark Colossus\
    }\
    \
    -- List of NPC ids\
    -- if you want to see their full name instead\
    modTable.fullName = {\
        -- [123456] = true,\
    }\
    \
    modTable.isMaxLevel = IsLevelAtEffectiveMaxLevel(UnitLevel('player'))\
    \
    local function Hex(r, g, b)\
        if type(r) == 'table' then\
            r, g, b = r.r or r[1], r.g or r[2], r.b or r[3]\
        end\
        \
        return (r and type(r) ~= 'string') and format('|cff%02x%02x%02x', r * 255, g * 255, b * 255) or '|cffFFFFFF'\
    end\
    \
    function level(unitId)\
        if modTable.isMaxLevel then return false end\
        \
        local level, color\
        \
        if IsRetailOrMists and (UnitIsWildBattlePet(unitId) or UnitIsBattlePetCompanion(unitId)) then\
            level = UnitBattlePetLevel(unitId)\
            local teamLevel = C_PetJournal.GetPetTeamAverageLevel()\
            color = (teamLevel ~= level) and GetRelativeDifficultyColor(teamLevel, level) or QuestDifficultyColors.difficult\
        else\
            level = UnitEffectiveLevel(unitId)\
            color = GetCreatureDifficultyColor(level)\
        end\
        \
        return format('%s%s|r - ', Hex(color), (level > 0) and level or '??')\
    end\
    \
    modTable.level = level\
    modTable.IsRetailOrMists = IsRetailOrMists\
end",
["Nameplate Updated"] = "function(self, unitId, unitFrame, envTable, modTable)\
    \
    local unitName = UnitName(unitId)\
    if not unitName then return end\
    \
    local npcId = unitFrame.namePlateNpcId\
    local displayName\
    \
    -- Ensure namePrefix is never nil\
    local namePrefix = modTable.level(unitId) or ''\
    \
    if modTable.firstName[npcId] then\
        -- Extract first word, fallback to full name if pattern fails\
        local firstName = unitName:match('^(%S+)') or unitName\
        displayName = namePrefix .. firstName\
    elseif modTable.fullName[npcId] then\
        displayName = namePrefix .. unitName\
    else\
        -- Extract last word, fallback to full name if pattern fails\
        local lastName = unitName:match('(%S+)%s*$') or unitName\
        displayName = namePrefix .. lastName\
    end\
    \
    unitFrame.healthBar.unitName:SetText(displayName)\
end",
},
["HooksTemp"] = {
},
["Icon"] = "Interface\\ICONS\\inv_misc_wrench_01",
["LastHookEdited"] = "Nameplate Updated",
["LoadConditions"] = {
