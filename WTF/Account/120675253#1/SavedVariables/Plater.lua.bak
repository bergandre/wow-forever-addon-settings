["Name"] = "Cast - Glowing [P]",
["NpcNames"] = {
},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    if (unitFrame.felAnimation and unitFrame.felAnimation.Textures) then\
        for i = 1, scriptTable.config.segmentsAmount  do\
            local texture = unitFrame.felAnimation.Textures[i]\
            if (texture) then\
                texture:Hide()\
            end\
        end\
    end\
    \
    if (unitFrame.felAnimation and unitFrame.felAnimation.textureStretched) then\
        local textureStretched = unitFrame.felAnimation.textureStretched\
        if (textureStretched) then\
            textureStretched:Hide()\
        end\
    end\
end\
\
\
