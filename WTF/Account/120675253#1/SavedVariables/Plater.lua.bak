},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable)\
    \
    envTable.glowEffect:Hide()\
    \
    envTable.BackgroundFlash:Stop()\
    \
    unitFrame:StopFrameShake (envTable.FrameShake)    \
    \
end\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable)\
