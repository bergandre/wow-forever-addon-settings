["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    if (envTable._SpellID == 191284) then\
        Plater.SetAltCastBar(unitFrame.PlateFrame, envTable.configAltCastBar, 4.70, GetTime(), 191284)\
        \
        C_Timer.After(4.75, function()\
                Plater.SetAltCastBar(unitFrame.PlateFrame, envTable.configAltCastBar, 5.30, GetTime(), 191284)\
        end)\
        \
        C_Timer.After(4.75 + 5.30, function()\
                Plater.SetAltCastBar(unitFrame.PlateFrame, envTable.configAltCastBar, 4.30, GetTime(), 191284)\
                C_Timer.After(4.50, function() unitFrame.castBar2:Hide() end)\
        end)\
    end\
    \
end",
