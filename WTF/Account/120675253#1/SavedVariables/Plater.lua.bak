    \
    textureBackground:SetMask([[Interface\\AddOns\\Plater\\masks\\mask_smallrectangle_rounded1]])\
    textureBackground:SetTexture([[Interface\\AddOns\\Plater\\masks\\mask_smallrectangle_rounded1]])\
    textureBackground:SetVertexColor(0.1215, 0.1176, 0.1294, 1)\
    \
    \
    --textureBackground:SetMask([[Interface/ChatFrame/UI-ChatIcon-HotS]])\
    --    \"Interface/ChatFrame/UI-ChatIcon-HotS\"\
    \
    local addIcon = unitFrame.AddIcon\
    addIcon:ClearAllPoints()\
    addIcon:SetPoint(\"left\", textureBackground, \"left\", 2, 0)\
    addIcon:SetSize(10, 10)\
