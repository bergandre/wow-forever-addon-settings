[3] = {
["Author"] = "Luckyone-Laughing Skull",
["Desc"] = "",
["Enabled"] = true,
["Hooks"] = {
["Initialization"] = "function(modTable)\
    \
    -- Last update by Luckyone: August 16, 2025\
    \
    local colors = {\
        priority = '#00fbff', -- Bright cyan 'Lightblue'\
        special = '#ff41fc', -- Vivid magenta 'Pink'\
    }\
    \
    modTable.NpcColors = {\
        -- Special coloring [SPECIAL]\
        [231176] = colors.special, -- Scaffolding [FLOOD]\
        [179733] = colors.special, -- Invigorating Fish Stick [GMBT]\
        [180433] = colors.special, -- Wandering Pulsar [GMBT]\
        [175576] = colors.special, -- Containment Cell [STRT]\
        [177237] = colors.special, -- Chains of Damnation [STRT]\
        [244302] = colors.special, -- Binding Javelin [EDA]\
        [240952] = colors.special, -- Evoked Spirit [EDA]\
        \
        -- Manaforge Omega [MF]\
        [241800] = colors.priority, -- Manaforged Titan [Nexus-King Salhadaar]\
        [242587] = colors.priority, -- Living Mass [Dimensius]\
        \
        -- Ara-Kara, City of Echoes [ARAK]\
        [216293] = colors.priority, -- Trilling Attendant\
        [218961] = colors.priority, -- Starved Crawler\
        [223253] = colors.priority, -- Bloodstained Webmage\
        [216340] = colors.priority, -- Sentry Stagshell\
        [216364] = colors.priority, -- Blood Overseer\
        \
        -- Eco-Dome Al'dani [EDA]\
        [234957] = colors.priority, -- Wastelander Ritualist\
        [234955] = colors.priority, -- Wastelander Pactspeaker\
        \
        -- Halls of Atonement [HOA]\
        [165414] = colors.priority, -- Depraved Obliterator\
        [164562] = colors.priority, -- Depraved Houndmaster\
        \
        -- Priory of the Sacred Flame [PSF]\
        [206697] = colors.priority, -- Devout Priest\
        [206698] = colors.priority, -- Fanatical Conjuror\
        [221760] = colors.priority, -- Risen Mage\
        \
        -- Operation: Floodgate [FLOOD]\
        [229686] = colors.priority, -- Venture Co. Surveyor\
        [229251] = colors.priority, -- Venture Co. Architect\
        [229212] = colors.priority, -- Darkfuse Demolitionist\
        [231312] = colors.priority, -- Venture Co. Electrician\
        \
        -- Tazavesh: So'leah's Gambit [GMBT]\
        [178142] = colors.priority, -- Murkbrine Fishmancer\
        [176551] = colors.priority, -- Vault Purifier\
        [179388] = colors.priority, -- Hourglass Tidesage\
        [180431] = colors.priority, -- Focused Ritualist\
        \
        -- Tazavesh: Streets of Wonder [STRT]\
        [177817] = colors.priority, -- Support Officer\
        [180336] = colors.priority, -- Cartel Wiseguy\
        [176395] = colors.priority, -- Overloaded Mailemental\
        [179841] = colors.priority, -- Veteran Sparkcaster\
        \
        -- The Dawnbreaker [DAWN]\
        [213892] = colors.priority, -- Nightfall Shadowmage\
        [214761] = colors.priority, -- Nightfall Ritualist\
        [213893] = colors.priority, -- Nightfall Darkcaster\
    }\
    \
    function modTable.UpdateColor(unitFrame, envTable)\
        if not unitFrame or not unitFrame.namePlateNpcId then return end\
        if unitFrame.IsNpcWithoutHealthbar or unitFrame.IsFriendlyPlayerWithoutHealthbar then return end\
        \
        local color = modTable.NpcColors[unitFrame.namePlateNpcId]\
        if color then\
            Plater.SetNameplateColor(unitFrame, color)\
        end\
    end\
end",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable, modTable)\
    modTable.UpdateColor(unitFrame, envTable)\
end",
},
