",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    if (scriptTable.config.useNameplateColor) then\
        envTable.NameplateColor = Plater.GetColorByPriority(unitFrame, scriptTable.config.nameplateColor)\
        Plater.DenyColorChange(unitFrame, true)\
    end    \
    \
    unitFrame.healthBar._savedOriginalScale = unitFrame.healthBar:GetScale()\
    \
    if (scriptTable.config.useNameplateScale) then\
        unitFrame.healthBar:SetScale(scriptTable.config.scale)\
    end\
    \
end\
\
\
\
