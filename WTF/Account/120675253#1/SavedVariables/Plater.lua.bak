",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    if (unitFrame.AddSpawnIDTexture) then\
        unitFrame.AddSpawnIDTexture:Hide()\
        unitFrame.AddIcon:Hide()\
        unitFrame.AddNumber:Hide()\
    end\
    \
    scriptTable.ArrangeNpcNumbers(unitFrame.namePlateUnitGUID)\
    \
    local textureBackground = unitFrame.AddSpawnIDTexture\
    textureBackground:SetSize(22, 10)\
    textureBackground:ClearAllPoints()\
    textureBackground:SetPoint(\"bottomright\", unitFrame.healthBar, \"topright\", 0, 1)\
    \
    textureBackground:SetMask([[Interface\\AddOns\\Plater\\masks\\mask_smallrectangle_rounded1]])\
    textureBackground:SetTexture([[Interface\\AddOns\\Plater\\masks\\mask_smallrectangle_rounded1]])\
    textureBackground:SetVertexColor(0.1215, 0.1176, 0.1294, 1)\
    \
    \
    --textureBackground:SetMask([[Interface/ChatFrame/UI-ChatIcon-HotS]])\
    --    \"Interface/ChatFrame/UI-ChatIcon-HotS\"\
    \
    local addIcon = unitFrame.AddIcon\
    addIcon:ClearAllPoints()\
    addIcon:SetPoint(\"left\", textureBackground, \"left\", 2, 0)\
    addIcon:SetSize(10, 10)\
    \
    local addNumber = unitFrame.AddNumber\
    addNumber:ClearAllPoints()\
    addNumber:SetPoint(\"right\", textureBackground, \"right\", -2, 0)\
    DetailsFramework:SetFontSize(addNumber, 10)\
    \
end\
\
\
