[36] = {
["Author"] = "Izimode-Azralon",
["Desc"] = "Gold/Silvery Dragon,like blz original",
["Enabled"] = true,
["Hooks"] = {
["Constructor"] = "function (self, unitId, unitFrame, envTable)\
    \
    --both elite and rare,show both gold and silvery dragon,\
    --true = both,false = only silvery dragon\
    envTable.showbothRareAndElite = true\
    --show worldboss icon only when worldboss and elite/rare both,default-false\
    envTable.showworldbossonly = false\
    --true:show worldboss icon\
    envTable.showworldbossicon = true\
    \
    --IndicatorSize,default 10\
    envTable.IndicatorSize = 10\
    --test mode,for enemy npc,show quest,rare,elite,worldboss,pet ,default:false\
    envTable.TestMode = false\
    \
    --Adjust Indictors and RaidMard,the Anchor should select Left.\
    --this option let RaidMark always on indictors' left insted of overlap sometimes.\
    envTable.AdjustRaidMarkPosition = true\
    \
    --show friendlynpc quest icon--default:true\
    envTable.friendlynpcquest = true--Plater.db.profile.plate_config.friendlynpc.quest_enabled\
end",
["Destructor"] = "function (self, unitId, unitFrame, envTable)\
    --insert code here\
    --TEST\
    if envTable.AdjustRaidMarkPosition then\
        unitFrame.PlaterRaidTargetFrame:Show()\
    end\
end",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable)\
    \
    local profile = Plater.db.profile\
    --local plateFrame = unitFrame:GetParent()\
    local plateFrame = C_NamePlate.GetNamePlateForUnit (unitId)\
    local actorType = plateFrame.actorType    \
    \
    --unit reaction\
    local UNITREACTION_HOSTILE = 3\
    local UNITREACTION_NEUTRAL = 4\
    local UNITREACTION_FRIENDLY = 5\
    \
    local ACTORTYPE_FRIENDLY_PLAYER = \"friendlyplayer\"\
    local ACTORTYPE_FRIENDLY_NPC = \"friendlynpc\"\
    local ACTORTYPE_ENEMY_PLAYER = \"enemyplayer\"\
    local ACTORTYPE_ENEMY_NPC = \"enemynpc\"\
    local ACTORTYPE_PLAYER = \"player\" \
    \
    local MEMBER_UNITID = \"namePlateUnitToken\"\
    local MEMBER_GUID = \"namePlateUnitGUID\"\
    local MEMBER_NPCID = \"namePlateNpcId\"\
    local MEMBER_QUEST = \"namePlateIsQuestObjective\"\
    local MEMBER_REACTION = \"namePlateUnitReaction\"\
    local MEMBER_ALPHA = \"namePlateAlpha\"\
    local MEMBER_RANGE = \"namePlateInRange\"\
    local MEMBER_NOCOMBAT = \"namePlateNoCombat\"\
    local MEMBER_NAME = \"namePlateUnitName\"\
    local MEMBER_NAMELOWER = \"namePlateUnitNameLower\"\
    local MEMBER_TARGET = \"namePlateIsTarget\"\
    local MEMBER_CLASSIFICATION = \"namePlateClassification\"\
    \
    -- ~indicators\
    function Plater.UpdateChangeIndicators (plateFrame, actorType)\
        local actorType = plateFrame.actorType    \
        --print(\"1\",actortype)\
        --limpa os indicadores\
        Plater.ClearChangeIndicators (plateFrame)\
        local config = Plater.db.profile\
        \
        if (actorType == ACTORTYPE_ENEMY_PLAYER) then\
            if (config.indicator_faction) then\
                --Plater.AddChangeIndicator (plateFrame, UnitFactionGroup (plateFrame [MEMBER_UNITID]))\
                Plater.AddChangeIndicator (plateFrame, UnitFactionGroup (unitId))           \
            end\
            if (config.indicator_enemyclass) then\
                Plater.AddChangeIndicator (plateFrame, \"classicon\")\
            end\
            if (config.indicator_spec) then \
                --> check if the user is using details\
                if (Details and Details.realversion >= 134) then\
                    local spec = Details:GetSpecByGUID (plateFrame [MEMBER_GUID])\
                    --local spec = Details:GetSpecByGUID (unitId)\
                    if (spec) then\
                        local texture, L, R, T, B = Details:GetSpecIcon (spec)\
                        Plater.AddChangeIndicator (plateFrame, \"specicon\", texture, L, R, T, B)\
                    end\
                end\
            end\
            \
        elseif (actorType == ACTORTYPE_ENEMY_NPC) then\
            \
            --is a pet\
            local unitType = Plater.GetUnitType (plateFrame)\
            --if (PET_CACHE [plateFrame [MEMBER_GUID]]) then\
            if (unitType == \"pet\" and config.indicator_pet) then\
                Plater.AddChangeIndicator (plateFrame, \"pet\")\
            end\
            \
            --classification\
            local unitClassification = UnitClassification (plateFrame.unitFrame.namePlateUnitToken) --elite minus normal rare rareelite worldboss\
            if ((unitClassification == \"worldboss\" or (UnitLevel (unitId) == -1)) and envTable.showworldbossicon) then\
                Plater.AddChangeIndicator (plateFrame, \"worldboss\")\
                if (unitClassification == \"rareelite\" and (config.indicator_rare or config.indicator_elite)) and (not envTable.showworldbossonly) then\
                    if envTable.showbothRareAndElite then\
                        Plater.AddChangeIndicator (plateFrame, \"elite\")\
                    end\
                    Plater.AddChangeIndicator (plateFrame, \"rare\")\
                else\
                    if (unitClassification == \"elite\" and config.indicator_elite) and (not envTable.showworldbossonly) then\
                        Plater.AddChangeIndicator (plateFrame, \"elite\")\
                    end\
                    if (unitClassification == \"rare\" and config.indicator_rare) and (not envTable.showworldbossonly) then\
                        Plater.AddChangeIndicator (plateFrame, \"rare\")\
                    end\
                end\
            elseif (unitClassification == \"rareelite\" and (config.indicator_rare or config.indicator_elite))  then\
                if envTable.showbothRareAndElite then\
                    Plater.AddChangeIndicator (plateFrame, \"elite\")\
                end\
                Plater.AddChangeIndicator (plateFrame, \"rare\")\
            else\
                if (unitClassification == \"elite\" and config.indicator_elite) then\
                    Plater.AddChangeIndicator (plateFrame, \"elite\")\
                end\
                if (unitClassification == \"rare\" and config.indicator_rare) then\
                    Plater.AddChangeIndicator (plateFrame, \"rare\")\
                end\
            end\
            \
            --quest boss\
            local isQuestBoss = UnitIsQuestBoss (plateFrame.unitFrame.namePlateUnitToken) --true false\
            if (isQuestBoss and config.indicator_quest) then\
                Plater.AddChangeIndicator (plateFrame, \"quest\")\
            end\
            \
        elseif (actorType == ACTORTYPE_FRIENDLY_NPC) then\
            if (plateFrame [MEMBER_QUEST] and envTable.friendlynpcquest) then\
                Plater.AddChangeIndicator (plateFrame, \"quest\")\
            end\
        end\
        \
        --custom indicators from scripts\
        for i = 1, #plateFrame.unitFrame.CustomIndicators do\
            Plater.AddChangeIndicator (plateFrame, \"custom\", unpack (plateFrame.unitFrame.CustomIndicators [i]))\
        end\
    end\
    \
    -- ~indicators--test mode:for ENEMY_NPC,show,quest,rare,elite,pet....\
    function Plater.TestModeUpdateChangeIndicators (plateFrame, actorType)\
        if  not envTable.TestMode then\
            return\
        end\
        local actorType = plateFrame.actorType    \
        Plater.ClearChangeIndicators (plateFrame)\
        if (actorType == ACTORTYPE_ENEMY_NPC) then\
            Plater.AddChangeIndicator (plateFrame, \"pet\")\
            Plater.AddChangeIndicator (plateFrame, \"worldboss\")\
            Plater.AddChangeIndicator (plateFrame, \"elite\")\
            Plater.AddChangeIndicator (plateFrame, \"rare\")\
            Plater.AddChangeIndicator (plateFrame, \"quest\")\
        end\
    end\
    \
    function Plater.AddChangeIndicator (plateFrame, indicator, ...)\
        \
        local thisIndicator = plateFrame.IconIndicators [plateFrame.IconIndicators.Next]\
        \
        if (not thisIndicator) then\
            local newIndicator = plateFrame.unitFrame.healthBar:CreateTexture (nil, \"overlay\")\
            newIndicator:SetSize (envTable.IndicatorSize, envTable.IndicatorSize)\
            tinsert (plateFrame.IconIndicators, newIndicator)\
            thisIndicator = newIndicator\
        end\
        \
        thisIndicator:Show()\
        thisIndicator:SetTexCoord (0, 1, 0, 1)\
        thisIndicator:SetVertexColor (1, 1, 1)\
        thisIndicator:SetDesaturated (false)\
        thisIndicator:SetSize (envTable.IndicatorSize, envTable.IndicatorSize)\
        \
        -- ~icons\
        if (indicator == \"pet\") then\
            thisIndicator:SetTexture ([[Interface\\AddOns\\Plater\\images\\peticon]])\
            \
        elseif (indicator == \"Horde\") then\
            thisIndicator:SetTexture ([[Interface\\PVPFrame\\PVP-Currency-Horde]])\
            thisIndicator:SetSize (envTable.IndicatorSize+2, envTable.IndicatorSize+2)\
            \
        elseif (indicator == \"Alliance\") then\
            thisIndicator:SetTexture ([[Interface\\PVPFrame\\PVP-Currency-Alliance]])\
            thisIndicator:SetTexCoord (4/32, 29/32, 2/32, 30/32)\
            thisIndicator:SetSize (envTable.IndicatorSize+2, envTable.IndicatorSize+2)\
            \
        elseif (indicator == \"elite\") then\
            thisIndicator:SetTexture ([[Interface\\TargetingFrame\\Nameplates]])\
            --thisIndicator:SetTexCoord (0, 0.15, 0.25, 0.53)\
            thisIndicator:SetTexCoord (0,10/64,15/64,32/64)\
            --thisIndicator:SetVertexColor (1, .8, 0)\
            thisIndicator:SetSize (envTable.IndicatorSize+2, envTable.IndicatorSize+2)\
            --print(\"elite\")\
        elseif (indicator == \"rare\") then\
            thisIndicator:SetTexture ([[Interface\\TargetingFrame\\Nameplates]])\
            --thisIndicator:SetTexCoord (0, 0.15, 0.52, 0.84)\
            thisIndicator:SetTexCoord (0,10/64,34/64,51/64) \
            thisIndicator:SetSize (envTable.IndicatorSize+2, envTable.IndicatorSize+2)\
            thisIndicator:SetDesaturated (true)\
            --print(\"rare\")\
        elseif (indicator == \"quest\") then\
            thisIndicator:SetTexture ([[Interface\\TARGETINGFRAME\\PortraitQuestBadge]])\
            thisIndicator:SetTexCoord (2/32, 26/32, 1/32, 31/32)\
            \
        elseif (indicator == \"classicon\") then\
            local _, class = UnitClass (plateFrame [MEMBER_UNITID])\
            if (class) then\
                thisIndicator:SetTexture ([[Interface\\GLUES\\CHARACTERCREATE\\UI-CharacterCreate-Classes]])\
                thisIndicator:SetTexCoord (unpack (CLASS_ICON_TCOORDS [class]))\
            end\
            \
        elseif (indicator == \"specicon\") then\
            local texture, L, R, T, B = ...\
            thisIndicator:SetTexture (texture)\
            thisIndicator:SetTexCoord (L, R, T, B)\
            \
        elseif (indicator == \"worldboss\") then\
            thisIndicator:SetTexture ([[Interface\\Scenarios\\ScenarioIcon-Boss]])\
            thisIndicator:SetSize (envTable.IndicatorSize+2+2, envTable.IndicatorSize+2+1)\
        elseif (indicator == \"custom\") then\
            local texture, width, height, color, L, R, T, B = ...\
            thisIndicator:SetTexture (texture)\
            thisIndicator:SetSize (width, height)\
            thisIndicator:SetTexCoord (L, R, T, B)\
            local r, g, b = DetailsFramework:ParseColors (color)\
            thisIndicator:SetVertexColor (r, g, b)\
        end\
        \
        if (plateFrame.IconIndicators.Next == 1) then\
            Plater.SetAnchor (thisIndicator, Plater.db.profile.indicator_anchor)\
        else\
            local attachTo = plateFrame.IconIndicators [plateFrame.IconIndicators.Next - 1]\
            --se for menor que 4 ele deve crescer para o lado da esquerda, nos outros casos vai para a direita\
            if (Plater.db.profile.indicator_anchor.side < 4) then\
                PixelUtil.SetPoint (thisIndicator, \"right\", attachTo, \"left\", -2, 0)\
            else\
                PixelUtil.SetPoint (thisIndicator, \"left\", attachTo, \"right\", 1, 0)\
            end\
        end\
        \
        plateFrame.IconIndicators.Next = plateFrame.IconIndicators.Next + 1\
    end\
    \
    function Plater.ClearChangeIndicators (plateFrame)\
        for _, indicator in ipairs (plateFrame.IconIndicators) do\
            indicator:Hide()\
            indicator:ClearAllPoints()\
        end\
        plateFrame.IconIndicators.Next = 1\
    end\
    \
    --indictors\
    if  not envTable.TestMode then\
        Plater.UpdateChangeIndicators (plateFrame, actorType)\
    else\
        Plater.TestModeUpdateChangeIndicators (plateFrame, actorType)\
    end\
    \
    --RaidMark\
    --Plater.UpdateRaidMarkersOnAllNameplates()\
    envTable.size = 22\
    envTable.side = Plater.db.profile.indicator_raidmark_anchor.side\
    envTable.x = Plater.db.profile.indicator_raidmark_anchor.x\
    envTable.y = Plater.db.profile.indicator_raidmark_anchor.y\
    local anchor = {\
        side = envTable.side, \
        x = envTable.x,\
        y = envTable.y,\
    }; \
    if (not  unitFrame.healthBar.RaidMarkAdjustFrame) then\
        envTable.RaidMarkAdjustFrame = Plater:CreateLabel (unitFrame.healthBar, \"\", Plater:GetTemplate (\"font\", \"OPTIONS_FONT_TEMPLATE\"));\
        Plater.SetAnchor (envTable.RaidMarkAdjustFrame, anchor);\
        unitFrame.healthBar.RaidMarkAdjustFrame = envTable.RaidMarkAdjustFrame\
    end\
    \
    unitFrame.healthBar.RaidMarkAdjustFrame:SetScale (Plater.db.profile.indicator_raidmark_scale)\
    local mark = GetRaidTargetIndex(unitId) \
    if mark then\
        unitFrame.healthBar.RaidMarkAdjustFrame:SetText (\"|TInterface\\\\TARGETINGFRAME\\\\UI-RaidTargetingIcon_\"..mark..\":\"..envTable.size..\":\"..envTable.size..\":3:1:|t\")\
    else\
        unitFrame.healthBar.RaidMarkAdjustFrame:SetText (\"\")\
    end\
    \
    if envTable.AdjustRaidMarkPosition then\
        unitFrame.PlaterRaidTargetFrame:Hide()\
        unitFrame.healthBar.RaidMarkAdjustFrame:Show()\
    else\
        unitFrame.PlaterRaidTargetFrame:Show()\
        unitFrame.healthBar.RaidMarkAdjustFrame:Hide()\
        return\
    end\
    if not (Plater.db.profile.indicator_anchor.side == 2 and Plater.db.profile.indicator_raidmark_anchor.side == 2) then\
        unitFrame.PlaterRaidTargetFrame:Show()\
        unitFrame.healthBar.RaidMarkAdjustFrame:Hide()\
        return\
    else\
        unitFrame.PlaterRaidTargetFrame:Hide()\
        unitFrame.healthBar.RaidMarkAdjustFrame:Show()\
    end\
    \
    local config = Plater.db.profile\
    local index = GetRaidTargetIndex (plateFrame.unitFrame.namePlateUnitToken)\
    local xoffset = 0\
    \
    local show_indicator_faction = (envTable.indicator_faction and (not config.indicator_faction)) or config.indicator_faction\
    local show_indicator_enemyclass = (envTable.indicator_enemyclass and (not config.indicator_enemyclass)) or config.indicator_enemyclass\
    local show_indicator_spec = (envTable.indicator_spec and (not config.indicator_spec)) or config.indicator_spec\
    local show_indicator_elite = (envTable.indicator_elite and (not config.indicator_elite)) or config.indicator_elite\
    local show_indicator_rare = (envTable.indicator_rare and (not config.indicator_rare)) or config.indicator_rare\
    local show_indicator_quest = (envTable.indicator_quest and (not config.indicator_quest)) or config.indicator_quest\
    --get the config for this actor type\
    --local plateConfigs = DB_PLATE_CONFIG [actorType]\
    local plateConfigs = profile.plate_config [actorType]\
    --get the config key based if the player is in combat\
    local castBarConfigKey, healthBarConfigKey, manaConfigKey = Plater.GetHashKey (isInCombat)\
    \
    --get the width and height from what the user set in the options panel\
    local healthBarWidth, healthBarHeight = unitFrame.customHealthBarWidth or plateConfigs [healthBarConfigKey][1], unitFrame.customHealthBarHeight or plateConfigs [healthBarConfigKey][2]\
    local castBarWidth, castBarHeight = unitFrame.customCastBarWidth or plateConfigs [castBarConfigKey][1], unitFrame.customCastBarHeight or plateConfigs [castBarConfigKey][2]\
    \
    --calculate the size deviation for pets\
    local unitType = Plater.GetUnitType (plateFrame)\
    if (unitType == \"pet\") then\
        healthBarHeight = healthBarHeight * Plater.db.profile.pet_height_scale\
        healthBarWidth = healthBarWidth * Plater.db.profile.pet_width_scale\
        \
    elseif (unitType == \"minus\") then\
        healthBarHeight = healthBarHeight * Plater.db.profile.minor_height_scale\
        healthBarWidth = healthBarWidth * Plater.db.profile.minor_width_scale\
    end\
    \
    envTable.w2 = healthBarWidth\
    envTable.h2 = healthBarHeight\
    envTable.cw2 = castBarWidth\
    envTable.ch2 = castBarHeight\
    \
    if (UnitIsPlayer(unitId) and plateFrame [MEMBER_REACTION] < UNITREACTION_FRIENDLY) then\
        if (show_indicator_faction) then\
            xoffset = xoffset + envTable.IndicatorSize + 2\
        end\
        if (show_indicator_enemyclass) then\
            xoffset = xoffset + envTable.IndicatorSize\
        end\
        if (show_indicator_spec) then \
            --> check if the user is using details\
            if (Details and Details.realversion >= 134) then\
                local spec = Details:GetSpecByGUID (plateFrame [MEMBER_GUID])\
                if (spec) then\
                    xoffset = xoffset + envTable.IndicatorSize\
                end\
            end\
        end\
        \
    elseif (plateFrame [MEMBER_REACTION] < UNITREACTION_FRIENDLY) then\
        \
        --is a pet\
        if (unitType == \"pet\" and config.indicator_pet)  then\
            xoffset = xoffset + envTable.IndicatorSize\
        end\
        \
        --classification\
        local unitClassification = UnitClassification (plateFrame.unitFrame.namePlateUnitToken) --elite minus normal rare rareelite worldboss\
        if ((unitClassification == \"worldboss\" or (UnitLevel (unitId) == -1)) and envTable.showworldbossicon) then\
            xoffset = xoffset + envTable.IndicatorSize + 2 + 2\
            if (unitClassification == \"rareelite\" and (show_indicator_rare or show_indicator_elite)) and (not envTable.showworldbossonly) then\
                if envTable.showbothRareAndElite then\
                    xoffset = xoffset + envTable.IndicatorSize + 2\
                end\
                xoffset = xoffset + envTable.IndicatorSize + 2\
            else\
                if (unitClassification == \"elite\" and show_indicator_elite) and (not envTable.showworldbossonly) then\
                    xoffset = xoffset + envTable.IndicatorSize + 2\
                end\
                if (unitClassification == \"rare\" and show_indicator_rare) and (not envTable.showworldbossonly) then\
                    xoffset = xoffset + envTable.IndicatorSize + 2\
                end\
            end\
        elseif (unitClassification == \"rareelite\" and (show_indicator_rare or show_indicator_elite)) then\
            if envTable.showbothRareAndElite then\
                xoffset = xoffset + envTable.IndicatorSize + 2\
            end\
            xoffset = xoffset + envTable.IndicatorSize + 2\
        else\
            if (unitClassification == \"elite\" and show_indicator_elite) then\
                xoffset = xoffset + envTable.IndicatorSize + 2\
            end\
            if (unitClassification == \"rare\" and show_indicator_rare) then\
                xoffset = xoffset + envTable.IndicatorSize + 2\
            end\
        end\
        \
        --quest boss\
        local isQuestBoss = UnitIsQuestBoss (plateFrame.unitFrame.namePlateUnitToken) --true false\
        if (isQuestBoss and show_indicator_quest) then\
            xoffset = xoffset + envTable.IndicatorSize\
        end\
        \
    elseif (plateFrame [MEMBER_REACTION] >= UNITREACTION_FRIENDLY) then\
        if (plateFrame [MEMBER_QUEST]) then\
            xoffset = xoffset + envTable.IndicatorSize\
        end\
    end\
    \
    if envTable.TestMode then\
        xoffset = envTable.IndicatorSize * 5 + 8\
    end\
    \
    envTable.x = -1 - xoffset + Plater.db.profile.indicator_raidmark_anchor.x\
    \
    envTable.y = Plater.db.profile.indicator_raidmark_anchor.y\
    envTable.side = Plater.db.profile.indicator_raidmark_anchor.side\
    if (index and not plateFrame.isSelf) then\
        Plater.SetAnchor (unitFrame.healthBar.RaidMarkAdjustFrame, envTable)\
    end\
    \
end",
},
