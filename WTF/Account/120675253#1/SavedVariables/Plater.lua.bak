["UID"] = "0x622bc8122a7529d",
["Hooks"] = {
["Initialization"] = "function(modTable)\n    \n    -- Last update by Luckyone: August 16, 2025\n    \n    local colors = {\n        priority = '#00fbff', -- Bright cyan 'Lightblue'\n        special = '#ff41fc', -- Vivid magenta 'Pink'\n    }\n    \n    modTable.NpcColors = {\n        -- Special coloring [SPECIAL]\n        [231176] = colors.special, -- Scaffolding [FLOOD]\n        [179733] = colors.special, -- Invigorating Fish Stick [GMBT]\n        [180433] = colors.special, -- Wandering Pulsar [GMBT]\n        [175576] = colors.special, -- Containment Cell [STRT]\n        [177237] = colors.special, -- Chains of Damnation [STRT]\n        [244302] = colors.special, -- Binding Javelin [EDA]\n        [240952] = colors.special, -- Evoked Spirit [EDA]\n        \n        -- Manaforge Omega [MF]\n        [241800] = colors.priority, -- Manaforged Titan [Nexus-King Salhadaar]\n        [242587] = colors.priority, -- Living Mass [Dimensius]\n        \n        -- Ara-Kara, City of Echoes [ARAK]\n        [216293] = colors.priority, -- Trilling Attendant\n        [218961] = colors.priority, -- Starved Crawler\n        [223253] = colors.priority, -- Bloodstained Webmage\n        [216340] = colors.priority, -- Sentry Stagshell\n        [216364] = colors.priority, -- Blood Overseer\n        \n        -- Eco-Dome Al'dani [EDA]\n        [234957] = colors.priority, -- Wastelander Ritualist\n        [234955] = colors.priority, -- Wastelander Pactspeaker\n        \n        -- Halls of Atonement [HOA]\n        [165414] = colors.priority, -- Depraved Obliterator\n        [164562] = colors.priority, -- Depraved Houndmaster\n        \n        -- Priory of the Sacred Flame [PSF]\n        [206697] = colors.priority, -- Devout Priest\n        [206698] = colors.priority, -- Fanatical Conjuror\n        [221760] = colors.priority, -- Risen Mage\n        \n        -- Operation: Floodgate [FLOOD]\n        [229686] = colors.priority, -- Venture Co. Surveyor\n        [229251] = colors.priority, -- Venture Co. Architect\n        [229212] = colors.priority, -- Darkfuse Demolitionist\n        [231312] = colors.priority, -- Venture Co. Electrician\n        \n        -- Tazavesh: So'leah's Gambit [GMBT]\n        [178142] = colors.priority, -- Murkbrine Fishmancer\n        [176551] = colors.priority, -- Vault Purifier\n        [179388] = colors.priority, -- Hourglass Tidesage\n        [180431] = colors.priority, -- Focused Ritualist\n        \n        -- Tazavesh: Streets of Wonder [STRT]\n        [177817] = colors.priority, -- Support Officer\n        [180336] = colors.priority, -- Cartel Wiseguy\n        [176395] = colors.priority, -- Overloaded Mailemental\n        [179841] = colors.priority, -- Veteran Sparkcaster\n        \n        -- The Dawnbreaker [DAWN]\n        [213892] = colors.priority, -- Nightfall Shadowmage\n        [214761] = colors.priority, -- Nightfall Ritualist\n        [213893] = colors.priority, -- Nightfall Darkcaster\n    }\n    \n    function modTable.UpdateColor(unitFrame, envTable)\n        if not unitFrame or not unitFrame.namePlateNpcId then return end\n        if unitFrame.IsNpcWithoutHealthbar or unitFrame.IsFriendlyPlayerWithoutHealthbar then return end\n        \n        local color = modTable.NpcColors[unitFrame.namePlateNpcId]\n        if color then\n            Plater.SetNameplateColor(unitFrame, color)\n        end\n    end\nend",
["Nameplate Updated"] = "function (self, unitId, unitFrame, envTable, modTable)\n    modTable.UpdateColor(unitFrame, envTable)\nend",
},
