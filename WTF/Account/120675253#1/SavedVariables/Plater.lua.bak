[57] = {
["Author"] = "Terciob",
["ConstructorCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    function envTable.PlaySwipeAnimation(unitFrame)\
        unitFrame.CastSwipeTexture:Show()\
        unitFrame.CastSwipeAnimation:Play()\
        unitFrame.StartSwipeAnimation:Play()\
    end\
    \
    function envTable.StopSwipeAnimation(unitFrame)\
        unitFrame.EndSwipeAnimation:Play()\
        C_Timer.After(0.21, function()\
                unitFrame.CastSwipeAnimation:Stop()\
                unitFrame.CastSwipeTexture:Hide()\
        end)\
    end\
    \
    function envTable.CreateSwipeTextureAndAnimations(unitFrame)\
        if (unitFrame.CastSwipeTexture) then\
            return\
        end\
        \
        local swipeTexture = unitFrame:CreateTexture(nil, \"overlay\")\
        swipeTexture:SetTexture([[Interface\\AddOns\\Plater\\images\\circular_swipe.png]])\
        swipeTexture:SetPoint(\"center\", 0, 0)\
        swipeTexture:SetSize(64, 64)\
        swipeTexture:Hide()\
        \
        unitFrame.CastSwipeTexture = swipeTexture\
        \
        --rotation animation\
        unitFrame.CastSwipeAnimation = Plater:CreateAnimationHub(swipeTexture)\
        unitFrame.CastSwipeAnimation:SetLooping(\"repeat\")\
        unitFrame.CastSwipeAnimation.Rotation = Plater:CreateAnimation(unitFrame.CastSwipeAnimation, \"rotation\", 1, 1, 360)\
        \
        --starting animation\
        unitFrame.StartSwipeAnimation = Plater:CreateAnimationHub(swipeTexture, function()swipeTexture:Show() end)\
        unitFrame.StartSwipeAnimation.Alpha = Plater:CreateAnimation(unitFrame.StartSwipeAnimation, \"alpha\", 1, 0.2, 0, 1)\
        unitFrame.StartSwipeAnimation.Scale = Plater:CreateAnimation(unitFrame.StartSwipeAnimation, \"scale\", 1, 0.2, 1.3, 1.3, 1, 1)        \
        \
        --finished animation\
        unitFrame.EndSwipeAnimation = Plater:CreateAnimationHub(swipeTexture, nil, function()swipeTexture:Hide() end)\
        unitFrame.EndSwipeAnimation.Alpha = Plater:CreateAnimation(unitFrame.EndSwipeAnimation, \"alpha\", 1, 0.2, 1, 0)\
        unitFrame.EndSwipeAnimation.Scale = Plater:CreateAnimation(unitFrame.EndSwipeAnimation, \"scale\", 1, 0.2, 1, 1, 1.3, 1.3)\
    end\
    \
end\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
\
",
["Desc"] = "Play a animation when the spell effect is an circular AoE around the caster.",
["Enabled"] = true,
["Icon"] = "Interface\\AddOns\\Plater\\images\\circular_swipe",
["Initialization"] = "\9\9function (scriptTable)\
\9\9\9--insert code here\
\9\9\9\
\9\9end\
\9",
["Name"] = "Cast - AoE With Range [P]",
["NpcNames"] = {
},
["OnHideCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    envTable.StopSwipeAnimation(unitFrame)\
    unitFrame.CastSwipeTexture:Hide()\
end\
\
\
",
["OnShowCode"] = "function (self, unitId, unitFrame, envTable, scriptTable)\
    \
    envTable.CreateSwipeTextureAndAnimations(unitFrame)\
    \
    local options = scriptTable.config\
    local targetScale = scriptTable.config.textureScale\
    \
    --swipe rotation duration    \
    unitFrame.CastSwipeAnimation.Rotation:SetDuration(scriptTable.config.rotationDuration)\
    \
    unitFrame.CastSwipeTexture:SetTexture([[Interface\\AddOns\\Plater\\images\\circular_swipe.png]])\
    \
    --swipe texture settings\
    unitFrame.CastSwipeTexture:SetVertexColor(Plater:ParseColors(scriptTable.config.textureColor))\
    unitFrame.CastSwipeTexture:SetScale(targetScale)\
    unitFrame.CastSwipeTexture:SetAlpha(scriptTable.config.textureAlpha)  \
    \
    unitFrame.StartSwipeAnimation.Alpha:SetDuration(scriptTable.config.animStartDuration)\
    unitFrame.StartSwipeAnimation.Alpha:SetFromAlpha(scriptTable.config.textureStartAlpha)\
    unitFrame.StartSwipeAnimation.Alpha:SetToAlpha(scriptTable.config.textureAlpha)\
    \
    unitFrame.StartSwipeAnimation.Scale:SetDuration(scriptTable.config.animStartDuration)\
    \
    unitFrame.StartSwipeAnimation.Scale:SetScaleFrom(1.05, 1.05)\
    unitFrame.StartSwipeAnimation.Scale:SetScaleTo(1, 1)    \
    \
    unitFrame.EndSwipeAnimation.Scale:SetDuration(0.1)\
    unitFrame.EndSwipeAnimation.Alpha:SetDuration(0.1)\
    \
    --start playing\
    envTable.PlaySwipeAnimation(unitFrame)    \
    \
end\
\
\
",
